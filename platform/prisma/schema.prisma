// Prisma schema for The Courts member/admin platform.
// Phase 1 (MVP steps 1-9): identity, family hierarchy, staff/admin access,
// the programs/sessions catalog, the booking loop, memberships/entitlements,
// leagues (evaluations, teams, team practices/games), facility resources
// (Dr. Dish, court rentals, double-booking prevention), and waivers.
// See ../../docs/PLATFORM_ARCHITECTURE.md for the full approved schema and rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per guardian (parent) login. auth_id links to the Supabase Auth user.
model Guardian {
  id               String   @id @default(uuid())
  authId           String   @unique @map("auth_id")
  name             String
  email            String   @unique
  phone            String?
  stripeCustomerId String?  @unique @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")

  families         FamilyGuardian[]
  bookings         Booking[]
  waiverSignatures WaiverSignature[]
  communicationsReceived CommunicationRecipient[]

  @@map("guardians")
}

/// The household unit. Athletes belong to exactly one family;
/// guardians can belong to more than one (co-parents in separate households).
model Family {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  guardians    FamilyGuardian[]
  athletes     Athlete[]
  reservations ResourceReservation[]
  communications Communication[]
  leads          Lead[]
  tasks          Task[]

  @@map("families")
}

/// Join table: which guardians can access which family. N:N to support
/// co-parents/divorced households cleanly.
model FamilyGuardian {
  familyId   String  @map("family_id")
  guardianId String  @map("guardian_id")
  isPrimary  Boolean @default(false) @map("is_primary")

  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([familyId, guardianId])
  @@map("family_guardians")
}

/// A child/participant. Belongs to one family; never authenticates directly.
model Athlete {
  id               String   @id @default(uuid())
  familyId         String   @map("family_id")
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  dob              DateTime @db.Date
  grade            String?
  gender           String?
  medicalNotes     String?  @map("medical_notes")
  emergencyContact String?  @map("emergency_contact")
  photoConsent     Boolean  @default(false) @map("photo_consent")
  createdAt        DateTime @default(now()) @map("created_at")

  family           Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  waitlistEntries  WaitlistEntry[]
  memberships      AthleteMembership[]
  credits          Credit[]
  teamMemberships  TeamMember[]
  waiverSignatures WaiverSignature[]
  coachNotes       CoachNote[]
  evaluations      Evaluation[]
  flags            AthleteFlag[]
  incidentReports  IncidentReport[]
  drDishLogs       DrDishLog[]
  placementRequest PlacementRequest[]
  registrations    Registration[]

  @@map("athletes")
}

/// Staff/admin login. Deliberately separate from Guardian — a different trust
/// boundary, even though both authenticate through the same Supabase Auth.
model StaffUser {
  id        String    @id @default(uuid())
  authId    String    @unique @map("auth_id")
  name      String
  email     String    @unique
  role      StaffRole
  /// Sport scoping for the Coach App. A head_coach is scoped to the sports listed
  /// here ("Head of Basketball" is role=head_coach, sports=["Basketball"]) and sees
  /// nothing outside them. For role=coach this is descriptive only — a plain coach's
  /// access comes from their explicit SessionCoach/TeamCoach assignments, never from
  /// this list. Empty for admin, who is scoped to everything by role.
  sports    String[]  @default([]) @map("sports")
  phone     String?
  title     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")

  sessionAssignments   SessionCoach[]
  teamAssignments      TeamCoach[]
  attendanceRecords    AttendanceRecord[]
  coachNotes           CoachNote[]
  sessionNotes         SessionNote[]
  sessionPlans         SessionPlan[]
  planTemplates        PlanTemplate[]
  evaluations          Evaluation[]
  availability         CoachAvailability[]
  coverageRequested    CoverageRequest[]  @relation("CoverageRequestedBy")
  coverageAssigned     CoverageRequest[]  @relation("CoverageAssignedTo")
  incidentReports      IncidentReport[]
  communications       Communication[]
  announcements        Announcement[]
  athleteFlagsCreated  AthleteFlag[]
  drDishLogs           DrDishLog[]
  auditLogs            AuditLog[]
  creditLedgerEntries  CreditLedgerEntry[]
  registrationsCreated Registration[]
  leadsOwned           Lead[]              @relation("LeadOwner")
  leadActivities       LeadActivity[]
  promoCodesCreated    PromoCode[]
  facilityBlocks       FacilityBlock[]
  tasksCreated         Task[]              @relation("TaskCreatedBy")
  tasksAssigned        Task[]              @relation("TaskAssignedTo")
  contentBlocks        ContentBlock[]

  @@map("staff_users")
}

enum StaffRole {
  /// Owner / super admin. Full access to everything including business financials.
  owner
  admin
  front_desk
  coach
  /// Sport-level operational lead (Head of Basketball / Head of Volleyball).
  /// Scoped by StaffUser.sports — deliberately NOT automatic access to every sport.
  head_coach
  /// Content + featured programming only. No athlete PII, no financials.
  marketing
  /// Read-only access to revenue reporting. No operational write access.
  finance_viewer
}

/// Catalog entry — what's offered, not when. coach_id is deliberately not
/// on Session yet: Coach doesn't exist in the schema until its own step.
///
/// A league is just a Program with programType = league. There is no
/// separate LeagueSeason table — the candidate schema's league_seasons
/// (name, sport, registration_price_cents) fully overlapped fields Program
/// already has, so Team attaches directly to Program instead. One league
/// Program spans its whole lifecycle: its early Sessions are evaluation
/// time-slots (teamId null, booked through the same generic booking flow
/// as any class), and its later Sessions are team practices/games (teamId
/// set, created after evaluations once teams exist).
model Program {
  id               String      @id @default(uuid())
  name             String
  /// Staff-facing name, when the public name isn't operationally clear
  /// ("Fall 26 BB League – 3/4 Boys" vs. "Fall Basketball League").
  internalName     String?     @map("internal_name")
  programType      ProgramType @map("program_type")
  sport            String?
  description      String?
  priceCents       Int?        @map("price_cents")
  memberPriceCents Int?        @map("member_price_cents")
  /// Kept for backwards compatibility with the existing Parent App queries,
  /// which filter on `active`. `status` is the real lifecycle field for
  /// Courts OS; publishProgram() keeps the two in sync rather than leaving
  /// the old surface reading a field nobody maintains.
  active           Boolean     @default(true)
  status           ProgramStatus @default(draft)

  // --- Eligibility (progressive disclosure: not every type shows these) ---
  gradeMin         Int?        @map("grade_min")
  gradeMax         Int?        @map("grade_max")
  ageMin           Int?        @map("age_min")
  ageMax           Int?        @map("age_max")
  /// "any" | "boys" | "girls" — free text rather than an enum so a program
  /// can be described the way The Courts actually markets it.
  gender           String?
  skillLevel       String?     @map("skill_level")

  // --- Capacity + registration window ---
  defaultCapacity  Int?        @map("default_capacity")
  waitlistEnabled  Boolean     @default(true) @map("waitlist_enabled")
  registrationOpensAt  DateTime? @map("registration_opens_at")
  registrationClosesAt DateTime? @map("registration_closes_at")

  // --- Publish targets. "Create once, publish everywhere" is enforced by
  // these three flags being read by each surface, not by copying rows. ---
  visibleParentApp Boolean     @default(true) @map("visible_parent_app")
  visibleWebsite   Boolean     @default(false) @map("visible_website")
  visibleCoachApp  Boolean     @default(true) @map("visible_coach_app")

  // --- Stripe. The Price is authored in Stripe; we only hold the pointer. ---
  stripePriceId       String?  @map("stripe_price_id")
  stripeMemberPriceId String?  @map("stripe_member_price_id")

  imageUrl           String?   @map("image_url")
  cancellationPolicy String?   @map("cancellation_policy")
  /// League lifecycle stage. Null for every non-league program type.
  leagueStage        LeagueStage? @map("league_stage")
  seasonLabel        String?   @map("season_label")
  /// Set when duplicated, so "Clone Season" keeps a legible lineage.
  duplicatedFromId   String?   @map("duplicated_from_id")
  publishedAt        DateTime? @map("published_at")
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  sessions     Session[]
  entitlements PlanEntitlement[]
  teams        Team[]
  evaluations  Evaluation[]
  placementRequests PlacementRequest[]
  communications Communication[]
  announcements  Announcement[]
  registrations Registration[]
  promoCodes    PromoCode[]
  credits       Credit[]
  requiredWaivers ProgramWaiver[]
  tasks         Task[]
  duplicatedFrom Program?  @relation("ProgramLineage", fields: [duplicatedFromId], references: [id])
  duplicates     Program[] @relation("ProgramLineage")

  @@index([status])
  @@index([programType, status])
  @@map("programs")
}

enum ProgramStatus {
  draft
  published
  /// Registration closed, program still running.
  closed
  completed
  cancelled
  archived
}

enum LeagueStage {
  interest
  evaluation
  evaluation_complete
  registration
  team_placement
  season
  tournament
  complete
}

enum ProgramType {
  class
  camp
  league
  resource
  private
  rental
  /// A themed Courts moment (Halloween Hoops, Parents' Night Out, etc.) —
  /// reuses the same Program/Session/Booking machinery as everything else
  /// rather than a parallel events system, so admins manage it the same way.
  event
}

/// A single bookable occurrence of a program. Recurring classes materialize
/// into individual rows (via bulk generation) rather than being expanded
/// from a recurrence rule at read time.
model Session {
  id         String        @id @default(uuid())
  programId  String        @map("program_id")
  teamId     String?       @map("team_id")
  resourceId String?       @map("resource_id")
  startTime  DateTime      @map("start_time")
  endTime    DateTime      @map("end_time")
  capacity   Int
  status     SessionStatus @default(scheduled)
  createdAt  DateTime      @default(now()) @map("created_at")

  program         Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  resource        Resource?       @relation(fields: [resourceId], references: [id])
  team            Team?           @relation(fields: [teamId], references: [id])
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  coaches         SessionCoach[]
  plan            SessionPlan?
  notes           SessionNote[]
  coverageRequests CoverageRequest[]
  incidentReports IncidentReport[]
  drDishLogs      DrDishLog[]
  communications  Communication[]

  @@map("sessions")
}

enum SessionStatus {
  scheduled
  cancelled
}

/// A confirmed seat in a session. Simplification vs. the original candidate
/// schema: there is no "waitlisted" booking status — a waitlisted athlete has
/// a WaitlistEntry instead, and only gets a Booking once a seat is confirmed.
/// This keeps "has a seat" (Booking) and "wants a seat" (WaitlistEntry) as
/// two distinct, unambiguous states instead of overlapping ones.
model Booking {
  id                 String        @id @default(uuid())
  sessionId          String        @map("session_id")
  athleteId          String        @map("athlete_id")
  bookedByGuardianId String?       @map("booked_by_guardian_id")
  status             BookingStatus @default(booked)
  /// Attendance intent for team practices/games (league sessions with a
  /// teamId) — separate from `status`, which tracks the seat itself.
  /// Null means "no response yet"; left off drop-in class bookings, where
  /// an RSVP prompt wouldn't make sense.
  rsvpStatus         RsvpStatus?   @map("rsvp_status")
  priceChargedCents  Int?          @map("price_charged_cents")
  bookedAt           DateTime      @default(now()) @map("booked_at")

  /// The master Registration this seat belongs to, for programs registered
  /// at the program level (camps, leagues, multi-week clinics). Null for a
  /// drop-in class booking, which IS its own registration.
  registrationId     String?       @map("registration_id")

  session          Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete          Athlete           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  bookedByGuardian Guardian?         @relation(fields: [bookedByGuardianId], references: [id])
  registration     Registration?     @relation(fields: [registrationId], references: [id])
  attendance       AttendanceRecord?

  // One active-or-historical booking per athlete per session — re-booking
  // after a cancellation updates this row rather than creating a new one.
  @@unique([sessionId, athleteId])
  @@map("bookings")
}

enum RsvpStatus {
  going
  not_going
  not_sure
}

enum BookingStatus {
  booked
  cancelled
  attended
  no_show
}

/// A family wanting a seat in a full session. Ordered by position; the
/// oldest waiting entry is auto-converted to a Booking when a seat frees up.
model WaitlistEntry {
  id        String              @id @default(uuid())
  sessionId String              @map("session_id")
  athleteId String              @map("athlete_id")
  position  Int
  status    WaitlistEntryStatus @default(waiting)
  createdAt DateTime            @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([sessionId, athleteId])
  @@map("waitlist_entries")
}

enum WaitlistEntryStatus {
  waiting
  converted
}

/// A purchasable plan (e.g. "Weekly Basketball, $120/mo"). No
/// processor_subscription_id yet — payments aren't implemented, so
/// memberships are admin-assigned directly rather than billed. Add that
/// field when the payments step actually wires up a processor, not before.
model MembershipPlan {
  id              String          @id @default(uuid())
  name            String
  priceCents      Int             @map("price_cents")
  billingInterval BillingInterval @map("billing_interval")
  description     String?
  active          Boolean         @default(true)
  /// The Stripe Price ID this plan bills against. Null until the plan is wired up for online checkout —
  /// admins can still assign the plan manually (assignMembership) without one.
  stripePriceId   String?         @unique @map("stripe_price_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  entitlements PlanEntitlement[]
  memberships  AthleteMembership[]

  @@map("membership_plans")
}

enum BillingInterval {
  monthly
  annual
}

/// A plan assigned to one athlete.
model AthleteMembership {
  id                   String           @id @default(uuid())
  athleteId            String           @map("athlete_id")
  membershipPlanId     String           @map("membership_plan_id")
  status               MembershipStatus @default(active)
  startDate            DateTime         @map("start_date") @db.Date
  renewalDate          DateTime?        @map("renewal_date") @db.Date
  /// The Stripe Subscription ID, set once a guardian completes checkout for this membership.
  /// Null for memberships an admin assigned manually (assignMembership) without online billing.
  stripeSubscriptionId String?          @unique @map("stripe_subscription_id")
  createdAt            DateTime         @default(now()) @map("created_at")

  athlete Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  plan    MembershipPlan @relation(fields: [membershipPlanId], references: [id])

  @@map("athlete_memberships")
}

enum MembershipStatus {
  active
  paused
  cancelled
  /// Stripe subscription payment failed (past_due/unpaid) — distinct from a deliberate pause.
  past_due
}

/// What a plan grants — structured rather than hardcoded, so eligibility is
/// computed from data (see lib/entitlements.ts) instead of scattered
/// if-statements. class_credit is evaluated dynamically by counting the
/// athlete's bookings for programId within the current week against
/// quantityPerPeriod — there is no separate credit balance to keep in sync
/// for this benefit type; see Credit below for the different case that
/// genuinely needs one (a purchased pack that doesn't reset weekly).
model PlanEntitlement {
  id                String      @id @default(uuid())
  membershipPlanId  String      @map("membership_plan_id")
  benefitType       BenefitType @map("benefit_type")
  programId         String?     @map("program_id")
  quantityPerPeriod Int?        @map("quantity_per_period")

  plan    MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
  program Program?       @relation(fields: [programId], references: [id])

  @@map("plan_entitlements")
}

enum BenefitType {
  class_credit
  member_pricing
  league_eligibility
}

/// A purchased, decrementing balance (e.g. a Dr. Dish 10-pack) — unlike
/// class_credit above, this doesn't reset on a schedule. Not consumed by
/// anything yet since resource bookings (Dr. Dish) are a later MVP step;
/// the table exists now because memberships/credits are naturally one step.
model Credit {
  id         String    @id @default(uuid())
  athleteId  String    @map("athlete_id")
  creditType String    @map("credit_type")
  balance    Int
  source     String?
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  /// Monetary credits (e.g. the $25 Fall League evaluation credit) carry a
  /// value and the program they may be redeemed against. Session-pack credits
  /// leave these null and use `balance` as a count instead.
  valueCents        Int?    @map("value_cents")
  eligibleProgramId String? @map("eligible_program_id")
  status            CreditStatus @default(issued)
  /// Set when this credit was consumed, so the ledger never silently changes.
  redeemedAt        DateTime? @map("redeemed_at")

  athlete Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  eligibleProgram Program? @relation(fields: [eligibleProgramId], references: [id])
  ledgerEntries CreditLedgerEntry[]

  @@index([athleteId, status])
  @@map("credits")
}

enum CreditStatus {
  issued
  used
  expired
  cancelled
}

/// Every change to a Credit balance, appended — never an in-place edit.
/// "Never silently change balances" is a stated requirement, so the balance
/// column is the cached head of this ledger and every mutation writes a row
/// here recording who, when and why.
model CreditLedgerEntry {
  id           String   @id @default(uuid())
  creditId     String   @map("credit_id")
  /// Signed. +4 when a plan issues sessions, -1 when one is consumed.
  delta        Int
  balanceAfter Int      @map("balance_after")
  reason       String
  /// Null when the system issued/consumed it automatically.
  staffUserId  String?  @map("staff_user_id")
  sessionId    String?  @map("session_id")
  createdAt    DateTime @default(now()) @map("created_at")

  credit Credit     @relation(fields: [creditId], references: [id], onDelete: Cascade)
  staff  StaffUser? @relation(fields: [staffUserId], references: [id])

  @@index([creditId, createdAt])
  @@map("credit_ledger_entries")
}

/// A roster within a league Program, formed after evaluations. No
/// primaryCoachId yet — Coach doesn't exist in the schema, same
/// don't-build-ahead-of-need reasoning as Session's missing coach_id above.
model Team {
  id        String   @id @default(uuid())
  programId String   @map("program_id")
  name      String
  division  String?
  createdAt DateTime @default(now()) @map("created_at")

  program  Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  members  TeamMember[]
  sessions Session[]
  coaches  TeamCoach[]
  communications Communication[]
  announcements  Announcement[]

  @@map("teams")
}

model TeamMember {
  teamId    String   @map("team_id")
  athleteId String   @map("athlete_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@id([teamId, athleteId])
  @@map("team_members")
}

/// A physical, ownable thing that can't be double-booked (Court 1, Court 2,
/// Full Court, Dr. Dish). "cannot be double-booked" was called out as a
/// hard requirement from the start — see lib/resources.ts for how that's
/// actually enforced (a locked, transactional overlap check, the same
/// technique already used for session capacity, not a bare application-
/// layer check with a race window).
model Resource {
  id           String   @id @default(uuid())
  name         String
  resourceType String   @map("resource_type")
  capacity     Int      @default(1)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  /// Optional sport affinity, so the facility view can group Court 1/2 vs.
  /// a volleyball-only resource. Null means "usable by anything".
  sport        String?
  sortOrder    Int      @default(0) @map("sort_order")

  sessions     Session[]
  reservations ResourceReservation[]
  blocks       FacilityBlock[]

  @@map("resources")
}

/// An ad-hoc reservation NOT tied to the Program/Session catalog — a direct
/// court rental a family books outside of any class/camp/league context.
/// Program-driven resource use (e.g. a Dr. Dish session) goes through
/// Session.resourceId instead; both are checked together for conflicts.
model ResourceReservation {
  id                String                    @id @default(uuid())
  resourceId        String                    @map("resource_id")
  familyId          String                    @map("family_id")
  startTime         DateTime                  @map("start_time")
  endTime           DateTime                  @map("end_time")
  status            ResourceReservationStatus @default(confirmed)
  priceChargedCents Int?                      @map("price_charged_cents")
  createdAt         DateTime                  @default(now()) @map("created_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("resource_reservations")
}

enum ResourceReservationStatus {
  confirmed
  cancelled
}

/// Content stored directly rather than as a contentUrl to a file — no
/// object-storage infra (e.g. Supabase Storage) has been wired up yet, and
/// plain text/markdown needs none. scope decides what a signature attaches
/// to: `family` waivers need one signature per guardian (covers every
/// athlete in the family); `athlete` waivers need one per athlete.
model Waiver {
  id            String      @id @default(uuid())
  waiverType    String      @map("waiver_type")
  version       String
  content       String
  scope         WaiverScope @default(family)
  required      Boolean     @default(true)
  effectiveDate DateTime    @map("effective_date") @db.Date
  createdAt     DateTime    @default(now()) @map("created_at")

  signatures WaiverSignature[]
  programs   ProgramWaiver[]

  @@map("waivers")
}

enum WaiverScope {
  family
  athlete
}

/// athleteId is null for a family-scope signature (the guardian signed once,
/// covering the whole family) and set for an athlete-scope one. No DB
/// uniqueness constraint on (waiverId, guardianId, athleteId) — Postgres
/// unique constraints don't treat NULL athleteId values as equal to each
/// other, so it couldn't actually prevent duplicate family-scope signatures
/// anyway; the signing action checks for an existing signature first instead.
model WaiverSignature {
  id         String   @id @default(uuid())
  guardianId String   @map("guardian_id")
  athleteId  String?  @map("athlete_id")
  waiverId   String   @map("waiver_id")
  signedName String   @map("signed_name")
  signedAt   DateTime @default(now()) @map("signed_at")
  ipAddress  String?  @map("ip_address")

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  athlete  Athlete? @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  waiver   Waiver   @relation(fields: [waiverId], references: [id], onDelete: Cascade)

  @@map("waiver_signatures")
}

// ---------------------------------------------------------------------------
// COACH APP (coach.playthecourts.com)
//
// Everything below extends the SAME source of truth the Parent App and Admin
// already use. There is deliberately no coach-side copy of athletes, families,
// registrations, schedules or teams — the Coach App reads Athlete, Family,
// Booking, Session, Program and Team directly, and only adds the operational
// records that genuinely did not exist before (who is assigned to coach what,
// what actually happened in the gym, and what a coach observed).
// ---------------------------------------------------------------------------

/// Which staff are working a given Session. This is what fills the coach_id
/// gap the original Session comment called out — a join table rather than a
/// column because sessions routinely have a lead plus assistants, and because
/// substitute coverage needs to add a coach without overwriting the original
/// assignment (see CoverageRequest).
///
/// For a role=coach staff user this table IS their access boundary: a plain
/// coach can see a session if and only if a row here links them to it.
model SessionCoach {
  sessionId   String        @map("session_id")
  staffUserId String        @map("staff_user_id")
  role        CoachRole     @default(lead)
  assignedAt  DateTime      @default(now()) @map("assigned_at")

  session Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@id([sessionId, staffUserId])
  @@index([staffUserId])
  @@map("session_coaches")
}

enum CoachRole {
  lead
  assistant
  substitute
}

/// Which staff coach a league Team. Same reasoning as SessionCoach, and the
/// second half of a plain coach's access boundary: athletes on a team they
/// coach are visible to them even outside a specific session.
model TeamCoach {
  teamId      String    @map("team_id")
  staffUserId String    @map("staff_user_id")
  role        CoachRole @default(lead)
  assignedAt  DateTime  @default(now()) @map("assigned_at")

  team  Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staff StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@id([teamId, staffUserId])
  @@index([staffUserId])
  @@map("team_coaches")
}

/// What actually happened, kept separate from Booking.status (which tracks the
/// seat: booked/cancelled). The architecture doc called for exactly this split
/// so "intent to attend" and "actual outcome" don't collapse into one ambiguous
/// field — and the coach-facing states (here/late/absent/excused) are richer
/// than BookingStatus's attended/no_show.
///
/// markAttendance writes this row AND mirrors a coarse equivalent onto
/// Booking.status in the same transaction, so the pre-existing /admin roster
/// view keeps working. This record is the authoritative one.
model AttendanceRecord {
  id            String           @id @default(uuid())
  bookingId     String           @unique @map("booking_id")
  status        AttendanceStatus
  checkedInAt   DateTime?        @map("checked_in_at")
  recordedById  String?          @map("recorded_by_id")
  recordedAt    DateTime         @default(now()) @map("recorded_at")
  note          String?

  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recordedBy StaffUser? @relation(fields: [recordedById], references: [id])

  @@map("attendance_records")
}

enum AttendanceStatus {
  present
  late
  absent
  excused
}

/// A coach's observation about one athlete.
///
/// visibility is the single most safety-critical field in the Coach App: it
/// defaults to staff_private, and a note only becomes parent-visible when a
/// coach deliberately marks it parent_shared. The Parent App reads ONLY
/// parent_shared notes. There is no bulk "share all" path by design.
model CoachNote {
  id                 String         @id @default(uuid())
  athleteId          String         @map("athlete_id")
  staffUserId        String         @map("staff_user_id")
  sessionId          String?        @map("session_id")
  visibility         NoteVisibility @default(staff_private)
  body               String
  /// Quick tags (Ball Handling, Serving, Effort...) — sport-appropriate lists
  /// live in lib/coach-tags.ts, kept out of the DB so they can change freely.
  tags               String[]       @default([])
  focus              String?
  workingOn          String?        @map("working_on")
  nextRecommendation String?        @map("next_recommendation")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  athlete Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  staff   StaffUser @relation(fields: [staffUserId], references: [id])

  @@index([athleteId, createdAt])
  @@map("coach_notes")
}

enum NoteVisibility {
  staff_private
  parent_shared
}

/// A note about the group/session rather than an individual. Never parent-facing.
model SessionNote {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  staffUserId String   @map("staff_user_id")
  body        String
  createdAt   DateTime @default(now()) @map("created_at")

  session Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff   StaffUser @relation(fields: [staffUserId], references: [id])

  @@map("session_notes")
}

/// A lightweight practice plan for one session — a short ordered list of
/// timed blocks, not whiteboard software.
model SessionPlan {
  id          String   @id @default(uuid())
  sessionId   String   @unique @map("session_id")
  staffUserId String   @map("staff_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  session Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff   StaffUser         @relation(fields: [staffUserId], references: [id])
  items   SessionPlanItem[]

  @@map("session_plans")
}

model SessionPlanItem {
  id       String  @id @default(uuid())
  planId   String  @map("plan_id")
  position Int
  minutes  Int
  activity String
  notes    String?

  plan SessionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, position])
  @@map("session_plan_items")
}

/// A reusable plan a head coach/admin approves for the whole staff (Phase 2
/// coaching library). Normal coaches can apply one to their session but not
/// create or edit approved templates.
model PlanTemplate {
  id          String   @id @default(uuid())
  name        String
  sport       String?
  category    String?
  createdById String   @map("created_by_id")
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy StaffUser          @relation(fields: [createdById], references: [id])
  items     PlanTemplateItem[]

  @@map("plan_templates")
}

model PlanTemplateItem {
  id         String  @id @default(uuid())
  templateId String  @map("template_id")
  position   Int
  minutes    Int
  activity   String
  notes      String?

  template PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, position])
  @@map("plan_template_items")
}

/// One coach's evaluation of one athlete for one league Program.
///
/// scores is Json rather than six columns because the category set is
/// sport-specific (basketball scores ball handling; volleyball scores serving)
/// and adding a sport shouldn't require a migration. The category definitions
/// live in lib/evaluation-rubrics.ts. Unique per (program, athlete, coach) so
/// several coaches can independently evaluate the same athlete and a head
/// coach can see them combined.
model Evaluation {
  id               String   @id @default(uuid())
  programId        String   @map("program_id")
  athleteId        String   @map("athlete_id")
  staffUserId      String   @map("staff_user_id")
  sport            String
  scores           Json     @default("{}")
  notes            String?
  recommendedLevel String?  @map("recommended_level")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  program Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  athlete Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  staff   StaffUser @relation(fields: [staffUserId], references: [id])

  @@unique([programId, athleteId, staffUserId])
  @@map("evaluations")
}

/// A parent's team-placement request ("would like to play with Drew").
/// Surfaced during team building as a REQUEST — explicitly advisory, never
/// auto-applied. Team assignment stays a human decision.
model PlacementRequest {
  id          String   @id @default(uuid())
  programId   String   @map("program_id")
  athleteId   String   @map("athlete_id")
  requestText String   @map("request_text")
  createdAt   DateTime @default(now()) @map("created_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("placement_requests")
}

/// Coach working availability. One table covers both shapes: a recurring
/// weekly block (weekday set, specificDate null) and a one-off conflict
/// (specificDate set, weekday null). Availability informs admin/head-coach
/// scheduling — it does not let a coach create public programming.
model CoachAvailability {
  id           String             @id @default(uuid())
  staffUserId  String             @map("staff_user_id")
  weekday      Int?
  specificDate DateTime?          @map("specific_date") @db.Date
  startMinute  Int                @map("start_minute")
  endMinute    Int                @map("end_minute")
  status       AvailabilityStatus @default(available)
  note         String?
  createdAt    DateTime           @default(now()) @map("created_at")

  staff StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@map("coach_availability")
}

enum AvailabilityStatus {
  available
  preferred
  unavailable
}

/// "I need coverage for this session." Raised by the assigned coach, resolved
/// by a head coach/admin assigning a replacement — which adds a SessionCoach
/// row with role=substitute rather than silently rewriting the original
/// assignment, so the staffing history stays legible.
model CoverageRequest {
  id            String         @id @default(uuid())
  sessionId     String         @map("session_id")
  requestedById String         @map("requested_by_id")
  reason        String?
  status        CoverageStatus @default(open)
  assignedToId  String?        @map("assigned_to_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  resolvedAt    DateTime?      @map("resolved_at")

  session     Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requestedBy StaffUser  @relation("CoverageRequestedBy", fields: [requestedById], references: [id])
  assignedTo  StaffUser? @relation("CoverageAssignedTo", fields: [assignedToId], references: [id])

  @@index([status])
  @@map("coverage_requests")
}

enum CoverageStatus {
  open
  assigned
  cancelled
}

/// Internal incident record (injury / behavior / facility). Factual fields
/// only — the form deliberately asks what happened and what was done, not for
/// any diagnosis. Visible to the reporting coach and to admin/head coach for
/// that sport; never to parents through the Parent App.
model IncidentReport {
  id                    String         @id @default(uuid())
  sessionId             String?        @map("session_id")
  athleteId             String?        @map("athlete_id")
  reportedById          String         @map("reported_by_id")
  occurredAt            DateTime       @map("occurred_at")
  incidentType          IncidentType   @map("incident_type")
  description           String
  actionTaken           String         @map("action_taken")
  parentNotified        Boolean        @default(false) @map("parent_notified")
  adminFollowUpRequired Boolean        @default(false) @map("admin_follow_up_required")
  status                IncidentStatus @default(open)
  createdAt             DateTime       @default(now()) @map("created_at")

  session    Session?  @relation(fields: [sessionId], references: [id])
  athlete    Athlete?  @relation(fields: [athleteId], references: [id])
  reportedBy StaffUser @relation(fields: [reportedById], references: [id])

  @@index([status])
  @@map("incident_reports")
}

enum IncidentType {
  injury
  behavior
  facility
  other
}

enum IncidentStatus {
  open
  under_review
  closed
}

/// A message a coach sends to an operational group. Recipients are resolved to
/// guardians at send time (CommunicationRecipient) — coaches address a session,
/// team, program or family, never a phone number, and never a minor directly.
/// The Parent App renders these; no personal contact details are exposed to
/// coaches or between families.
model Communication {
  id          String             @id @default(uuid())
  senderId    String             @map("sender_id")
  scope       CommunicationScope
  sessionId   String?            @map("session_id")
  teamId      String?            @map("team_id")
  programId   String?            @map("program_id")
  familyId    String?            @map("family_id")
  subject     String
  body        String
  sentAt      DateTime           @default(now()) @map("sent_at")

  sender     StaffUser                @relation(fields: [senderId], references: [id])
  session    Session?                 @relation(fields: [sessionId], references: [id])
  team       Team?                    @relation(fields: [teamId], references: [id])
  program    Program?                 @relation(fields: [programId], references: [id])
  family     Family?                  @relation(fields: [familyId], references: [id])
  recipients CommunicationRecipient[]

  @@index([sentAt])
  @@map("communications")
}

enum CommunicationScope {
  session
  team
  program
  family
}

/// Fan-out row: one per guardian who should see a Communication. Materialized
/// at send time so the Parent App inbox is a simple indexed read, and so the
/// recipient list is a permanent record of who was actually told what.
model CommunicationRecipient {
  id              String    @id @default(uuid())
  communicationId String    @map("communication_id")
  guardianId      String    @map("guardian_id")
  readAt          DateTime? @map("read_at")

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  guardian      Guardian      @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([communicationId, guardianId])
  @@index([guardianId, readAt])
  @@map("communication_recipients")
}

/// A sport- or program-wide notice from a head coach/admin. Broader and more
/// persistent than a Communication (which targets one specific group), and
/// surfaced in the Parent App to the families it applies to.
model Announcement {
  id          String    @id @default(uuid())
  createdById String    @map("created_by_id")
  sport       String?
  programId   String?   @map("program_id")
  teamId      String?   @map("team_id")
  title       String
  body        String
  publishedAt DateTime  @default(now()) @map("published_at")
  expiresAt   DateTime? @map("expires_at")

  createdBy StaffUser @relation(fields: [createdById], references: [id])
  program   Program?  @relation(fields: [programId], references: [id])
  team      Team?     @relation(fields: [teamId], references: [id])

  @@index([publishedAt])
  @@map("announcements")
}

/// Operational flags only. The permitted set is intentionally narrow and
/// non-stigmatizing — no health or behavioral labels live here; medical detail
/// stays in Athlete.medicalNotes behind its own permission check, and anything
/// incident-shaped belongs in IncidentReport.
model AthleteFlag {
  id          String          @id @default(uuid())
  athleteId   String          @map("athlete_id")
  flagType    AthleteFlagType @map("flag_type")
  note        String?
  createdById String          @map("created_by_id")
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  resolvedAt  DateTime?       @map("resolved_at")

  athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdBy StaffUser @relation(fields: [createdById], references: [id])

  @@index([athleteId, active])
  @@map("athlete_flags")
}

enum AthleteFlagType {
  new_athlete
  first_session
  needs_evaluation
  parent_follow_up
  attendance_concern
}

/// Manually recorded Guided Dr. Dish numbers.
///
/// These are typed in by the coach. There is NO Dr. Dish API integration in
/// this codebase — nothing here is machine-reported, and no value is inferred
/// or synthesized. If a real integration is added later it should populate
/// these same fields and set a source field, not a parallel table.
model DrDishLog {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  athleteId   String   @map("athlete_id")
  staffUserId String   @map("staff_user_id")
  workout     String?
  makes       Int?
  attempts    Int?
  focus       String?
  createdAt   DateTime @default(now()) @map("created_at")

  session Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  staff   StaffUser @relation(fields: [staffUserId], references: [id])

  @@unique([sessionId, athleteId])
  @@map("dr_dish_logs")
}

/// Append-only trail for sensitive staff actions — viewing emergency contacts
/// or medical notes, sharing a note with a parent, changing team assignments,
/// resolving coverage, filing an incident. Written by lib/audit.ts.
model AuditLog {
  id          String   @id @default(uuid())
  staffUserId String   @map("staff_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  staff StaffUser @relation(fields: [staffUserId], references: [id])

  @@index([staffUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ===========================================================================
// COURTS OS
//
// Everything below is the operational control layer. It deliberately adds to
// the existing model rather than shadowing it: a Registration points at the
// same Program the Parent App renders and the same Athlete the Coach App sees.
// There is no second copy of a family, program, session or roster anywhere.
// ===========================================================================

/// The master record of "this athlete is signed up for this program".
///
/// This is the missing middle layer the old schema lacked. A Booking is a seat
/// in ONE session; for a camp, league or multi-week clinic a family registers
/// once at the program level and then occupies many session seats. Registration
/// is that once — it owns the money, the paperwork and the status, and the
/// Bookings hang off it for attendance. For a drop-in class the Registration
/// and the single Booking are created together.
model Registration {
  id         String             @id @default(uuid())
  programId  String             @map("program_id")
  athleteId  String             @map("athlete_id")
  status     RegistrationStatus @default(started)
  paymentStatus PaymentStatus   @default(none) @map("payment_status")

  /// What the family was actually charged, after member pricing/promo. Held
  /// here because Stripe is the source of truth for the payment but not for
  /// "which registration was this for".
  amountCents      Int?    @map("amount_cents")
  /// Pointers only — never card data, never a cached Stripe object.
  stripeCheckoutSessionId String? @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String? @unique @map("stripe_payment_intent_id")
  promoCodeId       String? @map("promo_code_id")
  creditAppliedCents Int?   @map("credit_applied_cents")

  /// Registration question answers, keyed by question id.
  formResponses Json?     @map("form_responses")
  /// Denormalized "all required waivers signed" flag, recomputed on read in
  /// the registration detail view; stored so list views don't N+1.
  waiversComplete Boolean @default(false) @map("waivers_complete")

  /// Set when an admin registered this athlete manually rather than the
  /// family self-serving, so the audit story is legible.
  createdByStaffId String? @map("created_by_staff_id")
  adminNote        String? @map("admin_note")

  registeredAt DateTime  @default(now()) @map("registered_at")
  cancelledAt  DateTime? @map("cancelled_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  program        Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  athlete        Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdByStaff StaffUser? @relation(fields: [createdByStaffId], references: [id])
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id])
  bookings       Booking[]

  /// One registration per athlete per program. Re-registering after a
  /// cancellation updates this row, which is also what stops a double-click
  /// on Checkout from producing two registrations.
  @@unique([programId, athleteId])
  @@index([status])
  @@index([paymentStatus])
  @@map("registrations")
}

/// Deliberately short. Every extra status is one more thing an admin has to
/// interpret at 5pm with a gym full of kids.
enum RegistrationStatus {
  /// Family opened the flow, hasn't finished.
  started
  /// Finished the form but something is outstanding (waiver, payment info).
  incomplete
  registered
  waitlisted
  cancelled
  /// Needs a human: eligibility question, duplicate, disputed payment.
  admin_review
}

enum PaymentStatus {
  /// Free program, or nothing owed.
  none
  due
  pending
  paid
  failed
  refunded
  partially_refunded
}

/// Lightweight CRM. Explicitly NOT a general sales tool — it tracks people who
/// showed interest in The Courts and whether they converted, nothing more.
model Lead {
  id        String     @id @default(uuid())
  name      String
  email     String?
  phone     String?
  source    LeadSource @default(other)
  stage     LeadStage  @default(new)
  sport     String?
  /// Free text: "3rd grade son, asked about Tuesday group training".
  interest  String?
  notes     String?
  /// Set once the lead becomes a real family, linking pipeline to outcome.
  familyId  String?    @map("family_id")
  ownerId   String?    @map("owner_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  convertedAt DateTime? @map("converted_at")

  family     Family?        @relation(fields: [familyId], references: [id])
  owner      StaffUser?     @relation("LeadOwner", fields: [ownerId], references: [id])
  activities LeadActivity[]

  @@index([stage])
  @@index([source])
  @@map("leads")
}

enum LeadSource {
  website
  parent_referral
  coach_referral
  walk_in
  social
  nextgen_rollover
  camp
  league_evaluation
  event
  rental
  other
}

enum LeadStage {
  new
  contacted
  trial
  attended
  follow_up
  converted
  not_now
}

model LeadActivity {
  id          String   @id @default(uuid())
  leadId      String   @map("lead_id")
  staffUserId String?  @map("staff_user_id")
  note        String
  createdAt   DateTime @default(now()) @map("created_at")

  lead  Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staff StaffUser? @relation(fields: [staffUserId], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

/// A discount The Courts issued. The authoritative coupon lives in Stripe when
/// one is attached (stripePromotionCodeId); this row is the operational view —
/// who it went to, what it's for, whether it's been used.
model PromoCode {
  id          String      @id @default(uuid())
  code        String      @unique
  label       String
  /// Exactly one of these is set.
  amountOffCents Int?     @map("amount_off_cents")
  percentOff     Int?     @map("percent_off")
  status      PromoStatus @default(issued)
  /// Restricts redemption to one program (e.g. an evaluation credit that is
  /// only good against the Fall League).
  eligibleProgramId String? @map("eligible_program_id")
  source      String?
  maxRedemptions Int?     @map("max_redemptions")
  timesRedeemed  Int      @default(0) @map("times_redeemed")
  expiresAt   DateTime?   @map("expires_at")
  stripePromotionCodeId String? @unique @map("stripe_promotion_code_id")
  stripeCouponId        String? @map("stripe_coupon_id")
  createdById String?     @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  eligibleProgram Program?   @relation(fields: [eligibleProgramId], references: [id])
  createdBy       StaffUser? @relation(fields: [createdById], references: [id])
  registrations   Registration[]

  @@index([status])
  @@map("promo_codes")
}

enum PromoStatus {
  issued
  used
  expired
  cancelled
}

/// Facility unavailability that is not a booking — maintenance, a holiday, an
/// owner block. Checked by the same conflict logic that guards double-booking,
/// so a blocked court cannot take a new session.
model FacilityBlock {
  id         String  @id @default(uuid())
  /// Null means the WHOLE facility is blocked (holiday, snow closure).
  resourceId String? @map("resource_id")
  startTime  DateTime @map("start_time")
  endTime    DateTime @map("end_time")
  reason     FacilityBlockReason
  note       String?
  createdById String? @map("created_by_id")
  createdAt  DateTime @default(now()) @map("created_at")

  resource  Resource?  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdBy StaffUser? @relation(fields: [createdById], references: [id])

  @@index([startTime, endTime])
  @@map("facility_blocks")
}

enum FacilityBlockReason {
  maintenance
  private_event
  holiday
  repair
  owner_block
  other
}

/// Deliberately minimal — a follow-up list, not project management. It has no
/// projects, no subtasks, no dependencies, and that is the point.
model Task {
  id          String     @id @default(uuid())
  title       String
  detail      String?
  status      TaskStatus @default(open)
  dueDate     DateTime?  @map("due_date") @db.Date
  assignedToId String?   @map("assigned_to_id")
  createdById  String?   @map("created_by_id")

  /// Optional anchors. A task can hang off whatever it is actually about.
  familyId    String?    @map("family_id")
  programId   String?    @map("program_id")

  createdAt   DateTime   @default(now()) @map("created_at")
  completedAt DateTime?  @map("completed_at")

  assignedTo StaffUser? @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy  StaffUser? @relation("TaskCreatedBy", fields: [createdById], references: [id])
  family     Family?    @relation(fields: [familyId], references: [id])
  program    Program?   @relation(fields: [programId], references: [id])

  @@index([status, dueDate])
  @@map("tasks")
}

enum TaskStatus {
  open
  done
  cancelled
}

/// Frequently-changing marketing content, editable without a deploy. Slot-based
/// rather than a general CMS: there is a fixed set of places on the website and
/// in the apps whose copy changes weekly, and this covers exactly those.
model ContentBlock {
  id          String       @id @default(uuid())
  slot        ContentSlot  @unique
  enabled     Boolean      @default(false)
  headline    String?
  body        String?
  linkLabel   String?      @map("link_label")
  linkUrl     String?      @map("link_url")
  /// For the "featured program" slots.
  programId   String?      @map("program_id")
  updatedById String?      @map("updated_by_id")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")

  updatedBy StaffUser? @relation(fields: [updatedById], references: [id])

  @@map("content_blocks")
}

enum ContentSlot {
  announcement_bar
  homepage_featured_program
  featured_camp
  featured_league
  featured_event
  emergency_closure
  this_week_at_the_courts
  parent_app_announcement
  coach_app_announcement
}

/// Which waivers a program requires. A join table rather than an array column
/// so the registration flow can check completion with a real query.
model ProgramWaiver {
  programId String @map("program_id")
  waiverId  String @map("waiver_id")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  waiver  Waiver  @relation(fields: [waiverId], references: [id], onDelete: Cascade)

  @@id([programId, waiverId])
  @@map("program_waivers")
}
