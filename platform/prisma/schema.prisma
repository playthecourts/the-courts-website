// Prisma schema for The Courts member/admin platform.
// Phase 1 (MVP steps 1-7): identity, family hierarchy, staff/admin access,
// the programs/sessions catalog, the booking loop, memberships/entitlements,
// and leagues (evaluations, teams, team practices/games).
// See ../../docs/PLATFORM_ARCHITECTURE.md for the full approved schema and rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per guardian (parent) login. auth_id links to the Supabase Auth user.
model Guardian {
  id        String   @id @default(uuid())
  authId    String   @unique @map("auth_id")
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")

  families FamilyGuardian[]
  bookings Booking[]

  @@map("guardians")
}

/// The household unit. Athletes belong to exactly one family;
/// guardians can belong to more than one (co-parents in separate households).
model Family {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  guardians FamilyGuardian[]
  athletes  Athlete[]

  @@map("families")
}

/// Join table: which guardians can access which family. N:N to support
/// co-parents/divorced households cleanly.
model FamilyGuardian {
  familyId   String  @map("family_id")
  guardianId String  @map("guardian_id")
  isPrimary  Boolean @default(false) @map("is_primary")

  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([familyId, guardianId])
  @@map("family_guardians")
}

/// A child/participant. Belongs to one family; never authenticates directly.
model Athlete {
  id               String   @id @default(uuid())
  familyId         String   @map("family_id")
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  dob              DateTime @db.Date
  grade            String?
  gender           String?
  medicalNotes     String?  @map("medical_notes")
  emergencyContact String?  @map("emergency_contact")
  photoConsent     Boolean  @default(false) @map("photo_consent")
  createdAt        DateTime @default(now()) @map("created_at")

  family          Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  memberships     AthleteMembership[]
  credits         Credit[]
  teamMemberships TeamMember[]

  @@map("athletes")
}

/// Staff/admin login. Deliberately separate from Guardian — a different trust
/// boundary, even though both authenticate through the same Supabase Auth.
model StaffUser {
  id        String    @id @default(uuid())
  authId    String    @unique @map("auth_id")
  name      String
  email     String    @unique
  role      StaffRole
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("staff_users")
}

enum StaffRole {
  admin
  front_desk
  coach
}

/// Catalog entry — what's offered, not when. coach_id/resource_id are
/// deliberately not on Session yet: those entities (coaches, resources)
/// don't exist in the schema until their own MVP build steps.
///
/// A league is just a Program with programType = league. There is no
/// separate LeagueSeason table — the candidate schema's league_seasons
/// (name, sport, registration_price_cents) fully overlapped fields Program
/// already has, so Team attaches directly to Program instead. One league
/// Program spans its whole lifecycle: its early Sessions are evaluation
/// time-slots (teamId null, booked through the same generic booking flow
/// as any class), and its later Sessions are team practices/games (teamId
/// set, created after evaluations once teams exist).
model Program {
  id               String      @id @default(uuid())
  name             String
  programType      ProgramType @map("program_type")
  sport            String?
  description      String?
  priceCents       Int?        @map("price_cents")
  memberPriceCents Int?        @map("member_price_cents")
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now()) @map("created_at")

  sessions     Session[]
  entitlements PlanEntitlement[]
  teams        Team[]

  @@map("programs")
}

enum ProgramType {
  class
  camp
  league
  resource
  private
  rental
}

/// A single bookable occurrence of a program. Recurring classes materialize
/// into individual rows (via bulk generation) rather than being expanded
/// from a recurrence rule at read time.
model Session {
  id        String        @id @default(uuid())
  programId String        @map("program_id")
  teamId    String?       @map("team_id")
  startTime DateTime      @map("start_time")
  endTime   DateTime      @map("end_time")
  capacity  Int
  status    SessionStatus @default(scheduled)
  createdAt DateTime      @default(now()) @map("created_at")

  program         Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  team            Team?           @relation(fields: [teamId], references: [id])
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]

  @@map("sessions")
}

enum SessionStatus {
  scheduled
  cancelled
}

/// A confirmed seat in a session. Simplification vs. the original candidate
/// schema: there is no "waitlisted" booking status — a waitlisted athlete has
/// a WaitlistEntry instead, and only gets a Booking once a seat is confirmed.
/// This keeps "has a seat" (Booking) and "wants a seat" (WaitlistEntry) as
/// two distinct, unambiguous states instead of overlapping ones.
model Booking {
  id                 String        @id @default(uuid())
  sessionId          String        @map("session_id")
  athleteId          String        @map("athlete_id")
  bookedByGuardianId String?       @map("booked_by_guardian_id")
  status             BookingStatus @default(booked)
  priceChargedCents  Int?          @map("price_charged_cents")
  bookedAt           DateTime      @default(now()) @map("booked_at")

  session          Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete          Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  bookedByGuardian Guardian? @relation(fields: [bookedByGuardianId], references: [id])

  // One active-or-historical booking per athlete per session — re-booking
  // after a cancellation updates this row rather than creating a new one.
  @@unique([sessionId, athleteId])
  @@map("bookings")
}

enum BookingStatus {
  booked
  cancelled
  attended
  no_show
}

/// A family wanting a seat in a full session. Ordered by position; the
/// oldest waiting entry is auto-converted to a Booking when a seat frees up.
model WaitlistEntry {
  id        String              @id @default(uuid())
  sessionId String              @map("session_id")
  athleteId String              @map("athlete_id")
  position  Int
  status    WaitlistEntryStatus @default(waiting)
  createdAt DateTime            @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([sessionId, athleteId])
  @@map("waitlist_entries")
}

enum WaitlistEntryStatus {
  waiting
  converted
}

/// A purchasable plan (e.g. "Weekly Basketball, $120/mo"). No
/// processor_subscription_id yet — payments aren't implemented, so
/// memberships are admin-assigned directly rather than billed. Add that
/// field when the payments step actually wires up a processor, not before.
model MembershipPlan {
  id              String          @id @default(uuid())
  name            String
  priceCents      Int             @map("price_cents")
  billingInterval BillingInterval @map("billing_interval")
  description     String?
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")

  entitlements PlanEntitlement[]
  memberships  AthleteMembership[]

  @@map("membership_plans")
}

enum BillingInterval {
  monthly
  annual
}

/// A plan assigned to one athlete.
model AthleteMembership {
  id               String           @id @default(uuid())
  athleteId        String           @map("athlete_id")
  membershipPlanId String           @map("membership_plan_id")
  status           MembershipStatus @default(active)
  startDate        DateTime         @map("start_date") @db.Date
  renewalDate      DateTime?        @map("renewal_date") @db.Date
  createdAt        DateTime         @default(now()) @map("created_at")

  athlete Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  plan    MembershipPlan @relation(fields: [membershipPlanId], references: [id])

  @@map("athlete_memberships")
}

enum MembershipStatus {
  active
  paused
  cancelled
}

/// What a plan grants — structured rather than hardcoded, so eligibility is
/// computed from data (see lib/entitlements.ts) instead of scattered
/// if-statements. class_credit is evaluated dynamically by counting the
/// athlete's bookings for programId within the current week against
/// quantityPerPeriod — there is no separate credit balance to keep in sync
/// for this benefit type; see Credit below for the different case that
/// genuinely needs one (a purchased pack that doesn't reset weekly).
model PlanEntitlement {
  id                String      @id @default(uuid())
  membershipPlanId  String      @map("membership_plan_id")
  benefitType       BenefitType @map("benefit_type")
  programId         String?     @map("program_id")
  quantityPerPeriod Int?        @map("quantity_per_period")

  plan    MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
  program Program?       @relation(fields: [programId], references: [id])

  @@map("plan_entitlements")
}

enum BenefitType {
  class_credit
  member_pricing
  league_eligibility
}

/// A purchased, decrementing balance (e.g. a Dr. Dish 10-pack) — unlike
/// class_credit above, this doesn't reset on a schedule. Not consumed by
/// anything yet since resource bookings (Dr. Dish) are a later MVP step;
/// the table exists now because memberships/credits are naturally one step.
model Credit {
  id         String    @id @default(uuid())
  athleteId  String    @map("athlete_id")
  creditType String    @map("credit_type")
  balance    Int
  source     String?
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("credits")
}

/// A roster within a league Program, formed after evaluations. No
/// primaryCoachId yet — Coach doesn't exist in the schema, same
/// don't-build-ahead-of-need reasoning as Session's missing coach_id/
/// resource_id above.
model Team {
  id        String   @id @default(uuid())
  programId String   @map("program_id")
  name      String
  division  String?
  createdAt DateTime @default(now()) @map("created_at")

  program  Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  members  TeamMember[]
  sessions Session[]

  @@map("teams")
}

model TeamMember {
  teamId    String   @map("team_id")
  athleteId String   @map("athlete_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@id([teamId, athleteId])
  @@map("team_members")
}
