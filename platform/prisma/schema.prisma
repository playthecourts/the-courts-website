// Prisma schema for The Courts member/admin platform.
// Phase 1 (MVP steps 1-9): identity, family hierarchy, staff/admin access,
// the programs/sessions catalog, the booking loop, memberships/entitlements,
// leagues (evaluations, teams, team practices/games), facility resources
// (Dr. Dish, court rentals, double-booking prevention), and waivers.
// See ../../docs/PLATFORM_ARCHITECTURE.md for the full approved schema and rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per guardian (parent) login. auth_id links to the Supabase Auth user.
model Guardian {
  id               String   @id @default(uuid())
  /// Null for a guardian who has been ADDED to a family but has never signed in
  /// (a second parent entered by the first). They are a real person on the
  /// record with pickup rights and an emergency phone; they just have no login
  /// yet. When they do sign up, this is filled in — a new row is never created.
  authId           String?  @unique @map("auth_id")
  name             String
  /// Also nullable for the same reason. Unique still holds for the ones that
  /// have an address, since Postgres allows many NULLs in a unique index.
  email            String?  @unique
  phone            String?
  stripeCustomerId String?  @unique @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")

  families         FamilyGuardian[]
  bookings         Booking[]
  waiverSignatures WaiverSignature[]
  communicationsReceived CommunicationRecipient[]
  mediaConsents          MediaConsent[]
  mediaConsentChanges    MediaConsentChange[]
  emergencyContactLinks  EmergencyContact[]
  pickupLinks            AuthorizedPickup[]
  profileChanges         AthleteProfileChange[]
  messagesSent           Message[]
  featuredDecisions      FeaturedContentApproval[]

  @@map("guardians")
}

/// The household unit. Athletes belong to exactly one family;
/// guardians can belong to more than one (co-parents in separate households).
model Family {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  guardians    FamilyGuardian[]
  athletes     Athlete[]
  reservations ResourceReservation[]
  communications Communication[]
  leads          Lead[]
  tasks          Task[]
  messageThreads         MessageThread[]

  @@map("families")
}

/// Join table: which guardians can access which family. N:N to support
/// co-parents/divorced households cleanly.
model FamilyGuardian {
  familyId   String  @map("family_id")
  guardianId String  @map("guardian_id")
  isPrimary  Boolean @default(false) @map("is_primary")
  /// "Mom", "Dad", "Grandmother", "Stepfather" — free text on purpose; a fixed
  /// enum gets families wrong, and this is read by humans, not branched on.
  relationship String? @map("relationship")
  /// Pickup rights live here rather than on Athlete because they are a property
  /// of the adult's relationship to the household. Additional non-guardian
  /// pickup people are AuthorizedPickup rows.
  authorizedForPickup Boolean @default(true) @map("authorized_for_pickup")
  livesWithAthlete    Boolean? @map("lives_with_athlete")

  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([familyId, guardianId])
  @@map("family_guardians")
}

/// A child/participant. Belongs to one family; never authenticates directly.
model Athlete {
  id               String   @id @default(uuid())
  familyId         String   @map("family_id")
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  /// What they actually get called. Every parent-facing and coach-facing
  /// surface prefers this over firstName when it's set.
  nickname         String?
  /// Sensitive. The full date never renders on the Player Card or any roster —
  /// age and birthday MONTH are derived from it at render time (lib/athlete.ts).
  dob              DateTime @db.Date
  grade            String?
  school           String?
  gender           String?
  /// ["Basketball"], ["Volleyball"], or both. Array rather than an enum so an
  /// athlete who picks up a second sport is an update, not a migration.
  sports           String[] @default([]) @map("sports")
  /// Only meaningful when sports has both, and only if the parent chose to say.
  favoriteSport    String?  @map("favorite_sport")

  /// Object path inside the private athlete-photos bucket — NEVER a public URL.
  /// Rendered through a short-lived signed URL (lib/athlete-photo.ts).
  photoPath        String?  @map("photo_path")
  photoUpdatedAt   DateTime? @map("photo_updated_at")

  // --- The parts that make this a profile and not a registration packet ---
  /// "What do they want to get better at" — the athlete's own words, via parent.
  goal             String?
  /// How they like to be coached. Multi-select of COACHING_PREFERENCES keys.
  coachingPreferences String[] @default([]) @map("coaching_preferences")
  /// Personality, NOT skill. Never used for ranking, grouping or placement.
  competitiveMeter CompetitiveMeter? @map("competitive_meter")
  otherSports      String[] @default([]) @map("other_sports")
  /// The COACH-VISIBLE PARENT NOTE. Deliberately its own column, never merged
  /// into medicalNotes — "he shuts down if you correct him in front of the
  /// group" and "he carries an EpiPen" are different kinds of information with
  /// different audiences.
  parentCoachNote  String?  @map("parent_coach_note")

  // --- Safety ---
  /// The explicit yes/no answer, kept separate from the free text so "we asked
  /// and they said no" is distinguishable from "nobody ever filled this in".
  hasMedicalInfo   Boolean  @default(false) @map("has_medical_info")
  medicalNotes     String?  @map("medical_notes")
  /// Legacy free-text emergency contact from the first schema. Superseded by
  /// the EmergencyContact rows below; kept so no production data is lost, and
  /// read as a fallback when an athlete has no structured contact yet.
  emergencyContact String?  @map("emergency_contact")

  hasCustodyRestrictions Boolean @default(false) @map("has_custody_restrictions")
  /// HIGHLY RESTRICTED. Owner/admin/front desk only — never rendered in the
  /// Coach App, at any role.
  custodyRestrictions    String? @map("custody_restrictions")
  /// The minimum-necessary operational instruction a coach may see instead
  /// ("Do not release athlete to an unauthorized adult"). Written by staff,
  /// not by the parent, and deliberately carries no legal detail.
  custodyStaffInstruction String? @map("custody_staff_instruction")

  /// Legacy boolean from the first schema. MediaConsent is the real record;
  /// this is kept in sync for any older read path and is never the source of truth.
  photoConsent     Boolean  @default(false) @map("photo_consent")

  /// Set when step 1 is done — the athlete is on the roster and usable. The
  /// optional sections can be finished later without blocking anything.
  basicsCompletedAt DateTime? @map("basics_completed_at")
  /// Where the parent left off, so "Finish Later" resumes instead of restarting.
  profileStep       String?   @map("profile_step")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  family           Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  waitlistEntries  WaitlistEntry[]
  memberships      AthleteMembership[]
  credits          Credit[]
  teamMemberships  TeamMember[]
  waiverSignatures WaiverSignature[]
  coachNotes       CoachNote[]
  evaluations      Evaluation[]
  flags            AthleteFlag[]
  incidentReports  IncidentReport[]
  drDishLogs       DrDishLog[]
  placementRequest PlacementRequest[]
  offeringWaitlist OfferingWaitlistEntry[]
  messageThreads   MessageThread[]
  registrations    Registration[]
  emergencyContacts EmergencyContact[]
  authorizedPickups AuthorizedPickup[]
  mediaConsent      MediaConsent?
  mediaConsentChanges MediaConsentChange[]
  progressReports   ProgressReport[]
  profileChanges    AthleteProfileChange[]
  featuredApprovals      FeaturedContentApproval[]

  @@map("athletes")
}

/// How an athlete likes to be pushed. A PERSONALITY preference the coach reads
/// before a session — explicitly not a rating, not a level, and never an input
/// to team placement or grouping.
enum CompetitiveMeter {
  here_to_learn
  likes_a_challenge
  keep_score
}

/// Staff/admin login. Deliberately separate from Guardian — a different trust
/// boundary, even though both authenticate through the same Supabase Auth.
model StaffUser {
  id        String    @id @default(uuid())
  authId    String    @unique @map("auth_id")
  name      String
  email     String    @unique
  role      StaffRole
  /// Sport scoping for the Coach App. A head_coach is scoped to the sports listed
  /// here ("Head of Basketball" is role=head_coach, sports=["Basketball"]) and sees
  /// nothing outside them. For role=coach this is descriptive only — a plain coach's
  /// access comes from their explicit SessionCoach/TeamCoach assignments, never from
  /// this list. Empty for admin, who is scoped to everything by role.
  sports    String[]  @default([]) @map("sports")
  phone     String?
  title     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")

  sessionAssignments   SessionCoach[]
  teamAssignments      TeamCoach[]
  attendanceRecords    AttendanceRecord[]
  coachNotes           CoachNote[]
  sessionNotes         SessionNote[]
  sessionPlans         SessionPlan[]
  planTemplates        PlanTemplate[]
  evaluations          Evaluation[]
  availability         CoachAvailability[]
  coverageRequested    CoverageRequest[]  @relation("CoverageRequestedBy")
  coverageAssigned     CoverageRequest[]  @relation("CoverageAssignedTo")
  incidentReports      IncidentReport[]
  communications       Communication[]
  announcements        Announcement[]
  athleteFlagsCreated  AthleteFlag[]
  drDishLogs           DrDishLog[]
  auditLogs            AuditLog[]
  offeringsCreated     Offering[]         @relation("OfferingCreatedBy")
  offeringsPublished   Offering[]         @relation("OfferingPublishedBy")
  sessionsCancelled    Session[]          @relation("SessionCancelledBy")
  scheduleChanges      ScheduleChange[]
  conflictOverrides    ConflictOverride[]
  templatesCreated     OfferingTemplate[]
  waitlistOffers       WaitlistEntry[]
  offeringWaitlistOffers OfferingWaitlistEntry[]
  creditLedgerEntries  CreditLedgerEntry[]
  registrationsCreated Registration[]
  leadsOwned           Lead[]              @relation("LeadOwner")
  leadActivities       LeadActivity[]
  promoCodesCreated    PromoCode[]
  facilityBlocks       FacilityBlock[]
  tasksCreated         Task[]              @relation("TaskCreatedBy")
  tasksAssigned        Task[]              @relation("TaskAssignedTo")
  contentBlocks        ContentBlock[]
  progressReportsAuthored ProgressReport[] @relation("ProgressAuthor")
  progressReportsReviewed ProgressReport[] @relation("ProgressReviewer")
  mediaConsentChanges     MediaConsentChange[]
  profileChanges          AthleteProfileChange[]
  messagesSent            Message[]
  featuredRequests        FeaturedContentApproval[]

  @@map("staff_users")
}

enum StaffRole {
  /// Owner / super admin. Full access to everything including business financials.
  owner
  admin
  front_desk
  coach
  /// Sport-level operational lead (Head of Basketball / Head of Volleyball).
  /// Scoped by StaffUser.sports — deliberately NOT automatic access to every sport.
  head_coach
  /// Content + featured programming only. No athlete PII, no financials.
  marketing
  /// Read-only access to revenue reporting. No operational write access.
  finance_viewer
}

/// Catalog entry — what's offered, not when. coach_id is deliberately not
/// on Session yet: Coach doesn't exist in the schema until its own step.
///
/// A league is just a Program with programType = league. There is no
/// separate LeagueSeason table — the candidate schema's league_seasons
/// (name, sport, registration_price_cents) fully overlapped fields Program
/// already has, so Team attaches directly to Program instead. One league
/// Program spans its whole lifecycle: its early Sessions are evaluation
/// time-slots (teamId null, booked through the same generic booking flow
/// as any class), and its later Sessions are team practices/games (teamId
/// set, created after evaluations once teams exist).
/// The REUSABLE DEFINITION of something The Courts offers — "Basketball Group
/// Training", "Basketball Camp". It answers WHAT we run, never WHEN.
///
/// Everything season-specific (dates, price, staffing, registration rules,
/// publish targets, Stripe linkage) lives on Offering, so "Fall 2026 League"
/// and "Winter 2027 League" are two Offerings of ONE Program instead of two
/// unrelated Program rows that happen to share a name. The fields left here
/// that look season-ish (priceCents, defaultCapacity) are DEFAULTS seeded into
/// a new Offering — the Offering is what actually gets scheduled and charged.
model Program {
  id               String      @id @default(uuid())
  name             String
  /// Staff-facing name, when the public name isn't operationally clear
  /// ("Fall 26 BB League – 3/4 Boys" vs. "Fall Basketball League").
  internalName     String?     @map("internal_name")
  programType      ProgramType @map("program_type")
  sport            String?
  description      String?

  // --- Defaults inherited by each new Offering, so "create the Fall season"
  // never starts from a blank form. Editable per Offering afterwards. ---
  priceCents       Int?        @map("price_cents")
  memberPriceCents Int?        @map("member_price_cents")
  defaultCapacity  Int?        @map("default_capacity")
  defaultDurationMinutes Int?  @map("default_duration_minutes")
  defaultSkillLevel      SkillLevel? @map("default_skill_level")
  /// Whether an Offering of this program may be published with no coach
  /// assigned. Group Training and Private Training say no; Open Gym says yes.
  requiresCoach          Boolean @default(false) @map("requires_coach")
  /// Resource type an Offering of this program must reserve — "shooting_machine"
  /// for either Dr. Dish type. Null means no specific requirement.
  requiredResourceType   String? @map("required_resource_type")

  /// Kept for backwards compatibility with the existing Parent App queries,
  /// which filter on `active`. Offering.status is the real lifecycle field;
  /// publishOffering() keeps this in sync rather than leaving the old surface
  /// reading a field nobody maintains.
  active           Boolean     @default(true)
  /// Retired definitions stay queryable for history instead of being deleted.
  archivedAt       DateTime?   @map("archived_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at")

  offerings    Offering[]
  sessions     Session[]
  entitlements PlanEntitlement[]
  teams        Team[]
  evaluations  Evaluation[]
  placementRequests PlacementRequest[]
  communications Communication[]
  announcements  Announcement[]
  promoCodes    PromoCode[]
  credits       Credit[]
  tasks         Task[]

  @@index([programType, active])
  @@map("programs")
}

/// A specific, schedulable, sellable VERSION of a Program — "Fall Break
/// Basketball Camp 2026", "3rd–5th Grade Group Training · Fall 2026".
///
/// This is the row the whole system revolves around: sessions hang off it,
/// registrations point at it, pricing and Stripe linkage live on it, and the
/// three publish targets read it. Create it once here and the Parent App,
/// Coach App and website all render from this same row — there is no second
/// copy anywhere to keep in sync.
model Offering {
  id          String  @id @default(uuid())
  programId   String  @map("program_id")
  /// Public name. Falls back to the program's name when blank.
  name        String
  internalName String? @map("internal_name")
  /// "Fall 2026", "Winter 2027" — what makes two Offerings of one Program
  /// distinguishable at a glance.
  seasonLabel String? @map("season_label")

  status      OfferingStatus @default(draft)

  // --- Copy. Deliberately four separate fields: a six-paragraph website
  // description must never end up inside a compact Parent App card, and an
  // internal note must never reach a parent. ---
  shortDescription   String? @map("short_description")
  fullDescription    String? @map("full_description")
  /// Parent-facing logistics ("enter through the east doors").
  parentInstructions String? @map("parent_instructions")
  /// Coach App only.
  coachNotes         String? @map("coach_notes")
  /// Courts OS only. Never rendered on any parent- or coach-facing surface.
  internalNotes      String? @map("internal_notes")
  whatToBring        String[] @default([]) @map("what_to_bring")
  websiteCta         String? @map("website_cta")

  imageUrl       String? @map("image_url")
  imageMobileUrl String? @map("image_mobile_url")
  imageAltText   String? @map("image_alt_text")

  // --- Schedule shape. The occurrences themselves are Session rows; this
  // records what KIND of schedule the admin built so the builder can round-trip. ---
  scheduleKind ScheduleKind @default(one_time) @map("schedule_kind")
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date

  // --- Eligibility. Grade is first because that is how parents and admins
  // actually think; age is available for the cases that genuinely need it. ---
  gradeMin  Int?    @map("grade_min")
  gradeMax  Int?    @map("grade_max")
  ageMin    Int?    @map("age_min")
  ageMax    Int?    @map("age_max")
  /// "any" | "boys" | "girls" — free text rather than an enum so a program can
  /// be described the way The Courts actually markets it, and so gender is only
  /// recorded where it genuinely gates participation.
  gender    String?
  skillLevel SkillLevel? @map("skill_level")
  inviteOnly Boolean @default(false) @map("invite_only")
  /// Requires an active Training Plan to register at all (distinct from
  /// Training Plan members merely getting a better price).
  requiresTrainingPlan Boolean @default(false) @map("requires_training_plan")
  eligibilityNote String? @map("eligibility_note")

  // --- Capacity ---
  /// Whole-offering ceiling (a camp sells 40 seats across all four days).
  /// Null means capacity is tracked per session only.
  capacityTotal          Int? @map("capacity_total")
  /// Seeded onto each generated Session; individual sessions can differ.
  defaultSessionCapacity Int? @map("default_session_capacity")
  /// "Few spots left" threshold. Configurable because 3 is right for group
  /// training and wrong for a 40-seat camp.
  lowSpotThreshold       Int  @default(3) @map("low_spot_threshold")

  waitlistMode       WaitlistMode @default(automatic) @map("waitlist_mode")
  /// How long a waitlist offer is held before it expires to the next family.
  waitlistOfferHours Int @default(24) @map("waitlist_offer_hours")

  // --- Registration ---
  registrationMode     RegistrationMode @default(session) @map("registration_mode")
  registrationOpensAt  DateTime? @map("registration_opens_at")
  registrationClosesAt DateTime? @map("registration_closes_at")
  closeWhenFull        Boolean @default(false) @map("close_when_full")
  /// Multi-day offerings only: may a family buy a single day as well as the
  /// whole thing?
  allowSingleDay       Boolean @default(false) @map("allow_single_day")

  // --- Pricing. Stripe stays the source of truth for the payment objects; we
  // hold pointers plus the amounts we display. ---
  pricingModel        PricingModel @default(per_session) @map("pricing_model")
  priceCents          Int? @map("price_cents")
  memberPriceCents    Int? @map("member_price_cents")
  singleDayPriceCents Int? @map("single_day_price_cents")
  depositCents        Int? @map("deposit_cents")

  stripeProductId        String? @map("stripe_product_id")
  stripePriceId          String? @map("stripe_price_id")
  stripeMemberPriceId    String? @map("stripe_member_price_id")
  stripeSingleDayPriceId String? @map("stripe_single_day_price_id")
  /// Explicit Stripe tax code. NEVER inferred from marketing copy — coach-led
  /// training, league participation, open gym, court rental and merchandise can
  /// each be taxed differently, and guessing is a compliance problem. Null on a
  /// paid offering raises TAX SETUP REQUIRED at publish time.
  stripeTaxCode String? @map("stripe_tax_code")
  taxBehavior   TaxBehavior @default(unspecified) @map("tax_behavior")

  // --- Training Plan interaction. "Member" never silently means "free". ---
  creditRule        CreditRule @default(separate_payment) @map("credit_rule")
  /// Training Plan sessions consumed per booking when creditRule = uses_credit.
  creditsPerBooking Int @default(1) @map("credits_per_booking")

  // --- Publish targets. Create once, publish everywhere: each surface reads
  // these flags off this row. Nothing is copied anywhere. ---
  visibleParentApp Boolean @default(true) @map("visible_parent_app")
  visibleWebsite   Boolean @default(false) @map("visible_website")
  visibleCoachApp  Boolean @default(true) @map("visible_coach_app")
  /// Staff practice, internal meetings, invite-only training: occupies the
  /// facility and appears in Courts OS, reaches no public surface.
  internalOnly     Boolean @default(false) @map("internal_only")
  publishedAt      DateTime? @map("published_at")
  publishedById    String?   @map("published_by_id")

  /// League lifecycle stage. Null for every non-league offering.
  leagueStage LeagueStage? @map("league_stage")
  /// A league Offering points at its evaluation Offering. They stay DISTINCT
  /// registration and payment objects — a $25 evaluation is not a discount line
  /// on a $375 league — and any credit between them is configured explicitly.
  evaluationOfferingId String? @map("evaluation_offering_id")

  // --- Off-site programming (league games at another facility). ---
  externalLocationName    String? @map("external_location_name")
  externalLocationAddress String? @map("external_location_address")

  /// Lineage, so Clone Season stays legible.
  clonedFromOfferingId String? @map("cloned_from_offering_id")
  templateId           String? @map("template_id")

  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  archivedAt  DateTime? @map("archived_at")

  program         Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdBy       StaffUser? @relation("OfferingCreatedBy", fields: [createdById], references: [id])
  publishedBy     StaffUser? @relation("OfferingPublishedBy", fields: [publishedById], references: [id])
  clonedFrom      Offering?  @relation("OfferingLineage", fields: [clonedFromOfferingId], references: [id])
  clones          Offering[] @relation("OfferingLineage")
  evaluationFor   Offering?  @relation("LeagueEvaluation", fields: [evaluationOfferingId], references: [id])
  leaguesUsingThisEvaluation Offering[] @relation("LeagueEvaluation")
  template        OfferingTemplate? @relation(fields: [templateId], references: [id])

  sessions        Session[]
  recurrenceRules RecurrenceRule[]
  registrations   Registration[]
  teams           Team[]
  messageThreads  MessageThread[]
  requiredWaivers OfferingWaiver[]
  waitlist        OfferingWaitlistEntry[]
  scheduleChanges ScheduleChange[]

  @@index([status, startDate])
  @@index([programId, status])
  @@map("offerings")
}

/// Plain labels, because an admin reads these at 5pm with a gym full of kids.
enum OfferingStatus {
  draft
  ready_to_publish
  published
  registration_closed
  completed
  cancelled
  archived
}

enum ScheduleKind {
  one_time
  recurring
  multi_day
  season
  custom
}

enum SkillLevel {
  beginner
  developing
  intermediate
  advanced
  all_levels
  invite_only
}

enum WaitlistMode {
  none
  /// Families may add themselves; a freed seat still requires an explicit
  /// offer before anyone is booked or charged.
  automatic
  /// Admin adds families and runs promotion by hand.
  manual
}

/// What a family is actually buying. Not every program fits one model, which is
/// why this is per-Offering rather than global.
enum RegistrationMode {
  /// Book individual occurrences (group training, open gym, Dr. Dish).
  session
  /// One registration covers the whole run (camp, clinic).
  offering
  /// Whole camp, or individual days, per allowSingleDay.
  multi_day
  /// League: register for the season, get placed on a team.
  season
}

enum PricingModel {
  free
  one_time
  per_session
  multi_day_package
  /// Covered by a recurring Training Plan rather than sold per booking.
  training_plan
  deposit
}

/// Mirrors Stripe's own tax_behavior. `unspecified` is the honest default and
/// is what the publish check refuses to ship a paid offering with.
enum TaxBehavior {
  unspecified
  inclusive
  exclusive
}

/// How an Offering interacts with Training Plans. Deliberately explicit:
/// "member" does not imply "free", and the booking screen states the rule.
enum CreditRule {
  /// Booking consumes creditsPerBooking from the plan's weekly allowance.
  uses_credit
  /// Included with no credit consumed (unlimited-style benefit).
  included
  /// Members pay memberPriceCents; non-members pay priceCents.
  member_price
  /// Plan grants no benefit here; everyone pays.
  separate_payment
  free
}

/// Superseded by OfferingStatus — lifecycle moved to the Offering layer.
/// Retained because Postgres cannot drop an enum type that a dropped column
/// once used without a rewrite; nothing reads it.
enum ProgramStatus {
  draft
  published
  /// Registration closed, program still running.
  closed
  completed
  cancelled
  archived
}

enum LeagueStage {
  interest
  evaluation
  evaluation_complete
  registration
  team_placement
  season
  tournament
  complete
}

/// The Courts' own vocabulary, not generic SaaS categories. Each value selects a
/// distinct builder workflow — which field groups appear, which defaults apply,
/// whether a coach or a specific resource is required. See lib/programs/types.ts.
///
/// The first five are legacy names kept only so existing rows stay valid. Each
/// has a canonical successor (class→group_training, resource→guided_dr_dish,
/// private→private_training, rental→court_rental, event→special_event) and the
/// data migration moved every row over. Postgres cannot drop enum values without
/// a table rewrite, so they stay in the type and out of the UI.
enum ProgramType {
  class
  resource
  private
  rental
  event

  group_training
  private_training
  skills_clinic
  camp
  league
  evaluation
  guided_dr_dish
  self_serve_dr_dish
  open_gym
  court_rental
  party
  special_event
}

/// A single bookable occurrence of a program. Recurring classes materialize
/// into individual rows (via bulk generation) rather than being expanded
/// from a recurrence rule at read time.
/// One actual scheduled occurrence. Recurring programming materializes into
/// individual rows rather than being expanded from a rule at read time — which
/// is what makes "move just this Tuesday" possible without rebuilding a series.
model Session {
  id         String        @id @default(uuid())
  /// Denormalized from offering.programId and kept equal to it by the scheduling
  /// engine, which never writes one without the other. Every pre-Offering query
  /// in the Parent App, Coach App and entitlements engine reads this — keeping it
  /// is what let the Offering layer land without rewriting them. The Offering is
  /// the source of truth; this is a maintained index into it, not a second one.
  programId  String        @map("program_id")
  /// Which season/instance this belongs to. Nullable only for the pre-Offering
  /// rows the backfill adopted into legacy offerings; the engine always sets it.
  offeringId String?       @map("offering_id")
  /// Set when generated from a recurrence rule; null for one-time sessions,
  /// custom dates and camp days.
  seriesId   String?       @map("series_id")
  teamId     String?       @map("team_id")
  /// Primary resource. Additional courts for a multi-court program live in
  /// SessionResource; the conflict engine checks both together.
  resourceId String?       @map("resource_id")
  startTime  DateTime      @map("start_time")
  endTime    DateTime      @map("end_time")
  capacity   Int
  status     SessionStatus @default(scheduled)
  /// Per-occurrence label ("Day 2 — Tournament", "Make-up session"). The
  /// offering's name is used when null.
  title      String?
  /// 1-based day number inside a multi-day camp — drives single-day
  /// registration and day-by-day attendance. Null elsewhere.
  dayIndex   Int?          @map("day_index")
  /// True once this occurrence diverges from its series' rule (moved, re-staffed,
  /// re-courted). "Edit this and future" regenerates the rest and leaves these
  /// alone, so a deliberate one-off change is never silently reverted.
  isException Boolean      @default(false) @map("is_exception")
  /// Parent-facing note for this occurrence only.
  publicNote   String?     @map("public_note")
  /// Never leaves Courts OS / the Coach App.
  internalNote String?     @map("internal_note")
  cancellationReason String?   @map("cancellation_reason")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledById      String?   @map("cancelled_by_id")
  /// Set on a make-up session, pointing at the cancelled one it replaces, so a
  /// make-up never reads as an unrelated extra session.
  replacesSessionId  String?   @map("replaces_session_id")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at")

  program         Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  offering        Offering?       @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  series          RecurrenceRule? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  resource        Resource?       @relation(fields: [resourceId], references: [id])
  team            Team?           @relation(fields: [teamId], references: [id])
  cancelledBy     StaffUser?      @relation("SessionCancelledBy", fields: [cancelledById], references: [id])
  replaces        Session?        @relation("SessionReplacement", fields: [replacesSessionId], references: [id])
  replacedBy      Session[]       @relation("SessionReplacement")
  extraResources  SessionResource[]
  scheduleChanges ScheduleChange[]
  conflictOverrides ConflictOverride[]
  messageThreads  MessageThread[]
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  coaches         SessionCoach[]
  plan            SessionPlan?
  notes           SessionNote[]
  coverageRequests CoverageRequest[]
  incidentReports IncidentReport[]
  drDishLogs      DrDishLog[]
  communications  Communication[]

  @@index([offeringId, startTime])
  @@index([startTime, status])
  @@index([seriesId])
  @@map("sessions")
}

enum SessionStatus {
  scheduled
  cancelled
}

/// A confirmed seat in a session. Simplification vs. the original candidate
/// schema: there is no "waitlisted" booking status — a waitlisted athlete has
/// a WaitlistEntry instead, and only gets a Booking once a seat is confirmed.
/// This keeps "has a seat" (Booking) and "wants a seat" (WaitlistEntry) as
/// two distinct, unambiguous states instead of overlapping ones.
model Booking {
  id                 String        @id @default(uuid())
  sessionId          String        @map("session_id")
  athleteId          String        @map("athlete_id")
  bookedByGuardianId String?       @map("booked_by_guardian_id")
  status             BookingStatus @default(booked)
  /// Attendance intent for team practices/games (league sessions with a
  /// teamId) — separate from `status`, which tracks the seat itself.
  /// Null means "no response yet"; left off drop-in class bookings, where
  /// an RSVP prompt wouldn't make sense.
  rsvpStatus         RsvpStatus?   @map("rsvp_status")
  priceChargedCents  Int?          @map("price_charged_cents")
  bookedAt           DateTime      @default(now()) @map("booked_at")

  /// The master Registration this seat belongs to, for programs registered
  /// at the program level (camps, leagues, multi-week clinics). Null for a
  /// drop-in class booking, which IS its own registration.
  registrationId     String?       @map("registration_id")

  /// Which Training Plan benefit paid for this seat, recorded at booking time so
  /// a later plan change never rewrites history. Null for full-price bookings.
  creditSource       String?       @map("credit_source")
  /// Set once a Courts-side cancellation has returned this seat's Training Plan
  /// credit, so re-running the cancellation flow cannot restore it twice.
  creditRestored     Boolean       @default(false) @map("credit_restored")

  session          Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete          Athlete           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  bookedByGuardian Guardian?         @relation(fields: [bookedByGuardianId], references: [id])
  registration     Registration?     @relation(fields: [registrationId], references: [id])
  attendance       AttendanceRecord?

  // One active-or-historical booking per athlete per session — re-booking
  // after a cancellation updates this row rather than creating a new one.
  @@unique([sessionId, athleteId])
  @@map("bookings")
}

enum RsvpStatus {
  going
  not_going
  not_sure
}

enum BookingStatus {
  booked
  cancelled
  attended
  no_show
}

/// A family wanting a seat in a full session. Ordered by position; the
/// oldest waiting entry is auto-converted to a Booking when a seat frees up.
/// A family wanting a seat in a full session.
///
/// A freed seat is OFFERED to the next family and held until offerExpiresAt —
/// never silently booked and charged. That is the single most important rule in
/// this model: promotion is an invitation, not an enrolment.
model WaitlistEntry {
  id        String              @id @default(uuid())
  sessionId String              @map("session_id")
  athleteId String              @map("athlete_id")
  position  Int
  status    WaitlistEntryStatus @default(waiting)
  offeredAt      DateTime? @map("offered_at")
  offerExpiresAt DateTime? @map("offer_expires_at")
  offeredById    String?   @map("offered_by_id")
  respondedAt    DateTime? @map("responded_at")
  createdAt DateTime            @default(now()) @map("created_at")

  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete   Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  offeredBy StaffUser? @relation(fields: [offeredById], references: [id])

  @@unique([sessionId, athleteId])
  @@index([sessionId, status, position])
  @@map("waitlist_entries")
}

/// `converted` predates the promotion flow and means "became a booking". It is
/// kept as the terminal success state that `accepted` resolves into, so the old
/// auto-promotion path and the new offer path land on the same value.
enum WaitlistEntryStatus {
  waiting
  offered
  accepted
  declined
  expired
  converted
}

/// A purchasable plan (e.g. "Weekly Basketball, $120/mo"). No
/// processor_subscription_id yet — payments aren't implemented, so
/// memberships are admin-assigned directly rather than billed. Add that
/// field when the payments step actually wires up a processor, not before.
model MembershipPlan {
  id              String          @id @default(uuid())
  name            String
  priceCents      Int             @map("price_cents")
  billingInterval BillingInterval @map("billing_interval")
  description     String?
  active          Boolean         @default(true)
  /// The Stripe Price ID this plan bills against. Null until the plan is wired up for online checkout —
  /// admins can still assign the plan manually (assignMembership) without one.
  stripePriceId   String?         @unique @map("stripe_price_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  entitlements PlanEntitlement[]
  memberships  AthleteMembership[]

  @@map("membership_plans")
}

enum BillingInterval {
  monthly
  annual
}

/// A plan assigned to one athlete.
model AthleteMembership {
  id                   String           @id @default(uuid())
  athleteId            String           @map("athlete_id")
  membershipPlanId     String           @map("membership_plan_id")
  status               MembershipStatus @default(active)
  startDate            DateTime         @map("start_date") @db.Date
  renewalDate          DateTime?        @map("renewal_date") @db.Date
  /// The Stripe Subscription ID, set once a guardian completes checkout for this membership.
  /// Null for memberships an admin assigned manually (assignMembership) without online billing.
  stripeSubscriptionId String?          @unique @map("stripe_subscription_id")
  createdAt            DateTime         @default(now()) @map("created_at")

  athlete Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  plan    MembershipPlan @relation(fields: [membershipPlanId], references: [id])

  @@map("athlete_memberships")
}

enum MembershipStatus {
  active
  paused
  cancelled
  /// Stripe subscription payment failed (past_due/unpaid) — distinct from a deliberate pause.
  past_due
}

/// What a plan grants — structured rather than hardcoded, so eligibility is
/// computed from data (see lib/entitlements.ts) instead of scattered
/// if-statements. class_credit is evaluated dynamically by counting the
/// athlete's bookings for programId within the current week against
/// quantityPerPeriod — there is no separate credit balance to keep in sync
/// for this benefit type; see Credit below for the different case that
/// genuinely needs one (a purchased pack that doesn't reset weekly).
model PlanEntitlement {
  id                String      @id @default(uuid())
  membershipPlanId  String      @map("membership_plan_id")
  benefitType       BenefitType @map("benefit_type")
  programId         String?     @map("program_id")
  quantityPerPeriod Int?        @map("quantity_per_period")

  plan    MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
  program Program?       @relation(fields: [programId], references: [id])

  @@map("plan_entitlements")
}

enum BenefitType {
  class_credit
  member_pricing
  league_eligibility
}

/// A purchased, decrementing balance (e.g. a Dr. Dish 10-pack) — unlike
/// class_credit above, this doesn't reset on a schedule. Not consumed by
/// anything yet since resource bookings (Dr. Dish) are a later MVP step;
/// the table exists now because memberships/credits are naturally one step.
model Credit {
  id         String    @id @default(uuid())
  athleteId  String    @map("athlete_id")
  creditType String    @map("credit_type")
  balance    Int
  source     String?
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  /// Monetary credits (e.g. the $25 Fall League evaluation credit) carry a
  /// value and the program they may be redeemed against. Session-pack credits
  /// leave these null and use `balance` as a count instead.
  valueCents        Int?    @map("value_cents")
  eligibleProgramId String? @map("eligible_program_id")
  status            CreditStatus @default(issued)
  /// Set when this credit was consumed, so the ledger never silently changes.
  redeemedAt        DateTime? @map("redeemed_at")

  athlete Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  eligibleProgram Program? @relation(fields: [eligibleProgramId], references: [id])
  ledgerEntries CreditLedgerEntry[]

  @@index([athleteId, status])
  @@map("credits")
}

enum CreditStatus {
  issued
  used
  expired
  cancelled
}

/// Every change to a Credit balance, appended — never an in-place edit.
/// "Never silently change balances" is a stated requirement, so the balance
/// column is the cached head of this ledger and every mutation writes a row
/// here recording who, when and why.
model CreditLedgerEntry {
  id           String   @id @default(uuid())
  creditId     String   @map("credit_id")
  /// Signed. +4 when a plan issues sessions, -1 when one is consumed.
  delta        Int
  balanceAfter Int      @map("balance_after")
  reason       String
  /// Null when the system issued/consumed it automatically.
  staffUserId  String?  @map("staff_user_id")
  sessionId    String?  @map("session_id")
  createdAt    DateTime @default(now()) @map("created_at")

  credit Credit     @relation(fields: [creditId], references: [id], onDelete: Cascade)
  staff  StaffUser? @relation(fields: [staffUserId], references: [id])

  @@index([creditId, createdAt])
  @@map("credit_ledger_entries")
}

/// A roster within a league Program, formed after evaluations. No
/// primaryCoachId yet — Coach doesn't exist in the schema, same
/// don't-build-ahead-of-need reasoning as Session's missing coach_id above.
model Team {
  id        String   @id @default(uuid())
  programId String   @map("program_id")
  /// Which league season this roster belongs to. Same maintained-index
  /// relationship as Session.programId above: the Offering is the truth,
  /// programId stays equal to offering.programId for the existing queries.
  offeringId String? @map("offering_id")
  name      String
  division  String?
  createdAt DateTime @default(now()) @map("created_at")

  program  Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  offering Offering?    @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  members  TeamMember[]
  sessions Session[]
  coaches  TeamCoach[]
  communications Communication[]
  announcements  Announcement[]

  @@map("teams")
}

model TeamMember {
  teamId    String   @map("team_id")
  athleteId String   @map("athlete_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@id([teamId, athleteId])
  @@map("team_members")
}

/// A physical, ownable thing that can't be double-booked (Court 1, Court 2,
/// Full Court, Dr. Dish). "cannot be double-booked" was called out as a
/// hard requirement from the start — see lib/resources.ts for how that's
/// actually enforced (a locked, transactional overlap check, the same
/// technique already used for session capacity, not a bare application-
/// layer check with a race window).
model Resource {
  id           String   @id @default(uuid())
  name         String
  resourceType String   @map("resource_type")
  capacity     Int      @default(1)
  /// Column order in the facility scheduler.
  sortOrder    Int      @default(0) @map("sort_order")
  /// Program types allowed here. Empty means no restriction — the facility is
  /// configuration, not hard-coded.
  allowedProgramTypes ProgramType[] @default([]) @map("allowed_program_types")
  /// Resources this one physically overlaps. Full Court contains Half Court A
  /// and B, so booking either blocks the other. Stored symmetrically on both
  /// rows by the admin action; the conflict engine walks it. This is why
  /// "Court 1 is free" can be false even with no booking on Court 1.
  overlapsResourceIds String[] @default([]) @map("overlaps_resource_ids")
  description  String?
  /// Optional sport affinity, so the facility view can group Court 1/2 against
  /// a volleyball-only resource. Null means "usable by anything".
  sport        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  sessions         Session[]
  sessionResources SessionResource[]
  reservations     ResourceReservation[]
  blocks           FacilityBlock[]

  @@map("resources")
}

/// An ad-hoc reservation NOT tied to the Program/Session catalog — a direct
/// court rental a family books outside of any class/camp/league context.
/// Program-driven resource use (e.g. a Dr. Dish session) goes through
/// Session.resourceId instead; both are checked together for conflicts.
model ResourceReservation {
  id                String                    @id @default(uuid())
  resourceId        String                    @map("resource_id")
  familyId          String                    @map("family_id")
  startTime         DateTime                  @map("start_time")
  endTime           DateTime                  @map("end_time")
  status            ResourceReservationStatus @default(confirmed)
  priceChargedCents Int?                      @map("price_charged_cents")
  createdAt         DateTime                  @default(now()) @map("created_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("resource_reservations")
}

enum ResourceReservationStatus {
  confirmed
  cancelled
}

/// Content stored directly rather than as a contentUrl to a file — no
/// object-storage infra (e.g. Supabase Storage) has been wired up yet, and
/// plain text/markdown needs none. scope decides what a signature attaches
/// to: `family` waivers need one signature per guardian (covers every
/// athlete in the family); `athlete` waivers need one per athlete.
model Waiver {
  id            String      @id @default(uuid())
  waiverType    String      @map("waiver_type")
  version       String
  content       String
  scope         WaiverScope @default(family)
  required      Boolean     @default(true)
  effectiveDate DateTime    @map("effective_date") @db.Date
  createdAt     DateTime    @default(now()) @map("created_at")

  signatures WaiverSignature[]
  offerings  OfferingWaiver[]

  @@map("waivers")
}

enum WaiverScope {
  family
  athlete
}

/// athleteId is null for a family-scope signature (the guardian signed once,
/// covering the whole family) and set for an athlete-scope one. No DB
/// uniqueness constraint on (waiverId, guardianId, athleteId) — Postgres
/// unique constraints don't treat NULL athleteId values as equal to each
/// other, so it couldn't actually prevent duplicate family-scope signatures
/// anyway; the signing action checks for an existing signature first instead.
model WaiverSignature {
  id         String   @id @default(uuid())
  guardianId String   @map("guardian_id")
  athleteId  String?  @map("athlete_id")
  waiverId   String   @map("waiver_id")
  signedName String   @map("signed_name")
  signedAt   DateTime @default(now()) @map("signed_at")
  ipAddress  String?  @map("ip_address")

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  athlete  Athlete? @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  waiver   Waiver   @relation(fields: [waiverId], references: [id], onDelete: Cascade)

  @@map("waiver_signatures")
}

// ---------------------------------------------------------------------------
// COACH APP (coach.playthecourts.com)
//
// Everything below extends the SAME source of truth the Parent App and Admin
// already use. There is deliberately no coach-side copy of athletes, families,
// registrations, schedules or teams — the Coach App reads Athlete, Family,
// Booking, Session, Program and Team directly, and only adds the operational
// records that genuinely did not exist before (who is assigned to coach what,
// what actually happened in the gym, and what a coach observed).
// ---------------------------------------------------------------------------

/// Which staff are working a given Session. This is what fills the coach_id
/// gap the original Session comment called out — a join table rather than a
/// column because sessions routinely have a lead plus assistants, and because
/// substitute coverage needs to add a coach without overwriting the original
/// assignment (see CoverageRequest).
///
/// For a role=coach staff user this table IS their access boundary: a plain
/// coach can see a session if and only if a row here links them to it.
model SessionCoach {
  sessionId   String        @map("session_id")
  staffUserId String        @map("staff_user_id")
  role        CoachRole     @default(lead)
  assignedAt  DateTime      @default(now()) @map("assigned_at")

  session Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@id([sessionId, staffUserId])
  @@index([staffUserId])
  @@map("session_coaches")
}

/// Not everyone working a camp is a coach — check-in staff and event leads get
/// an honest role through the same table instead of being mislabeled "coach".
enum CoachRole {
  lead
  assistant
  substitute
  check_in
  event_lead
  court_lead
  other
}

/// Which staff coach a league Team. Same reasoning as SessionCoach, and the
/// second half of a plain coach's access boundary: athletes on a team they
/// coach are visible to them even outside a specific session.
model TeamCoach {
  teamId      String    @map("team_id")
  staffUserId String    @map("staff_user_id")
  role        CoachRole @default(lead)
  assignedAt  DateTime  @default(now()) @map("assigned_at")

  team  Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staff StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@id([teamId, staffUserId])
  @@index([staffUserId])
  @@map("team_coaches")
}

/// What actually happened, kept separate from Booking.status (which tracks the
/// seat: booked/cancelled). The architecture doc called for exactly this split
/// so "intent to attend" and "actual outcome" don't collapse into one ambiguous
/// field — and the coach-facing states (here/late/absent/excused) are richer
/// than BookingStatus's attended/no_show.
///
/// markAttendance writes this row AND mirrors a coarse equivalent onto
/// Booking.status in the same transaction, so the pre-existing /admin roster
/// view keeps working. This record is the authoritative one.
model AttendanceRecord {
  id            String           @id @default(uuid())
  bookingId     String           @unique @map("booking_id")
  status        AttendanceStatus
  checkedInAt   DateTime?        @map("checked_in_at")
  recordedById  String?          @map("recorded_by_id")
  recordedAt    DateTime         @default(now()) @map("recorded_at")
  note          String?

  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recordedBy StaffUser? @relation(fields: [recordedById], references: [id])

  @@map("attendance_records")
}

enum AttendanceStatus {
  present
  late
  absent
  excused
}

/// A coach's observation about one athlete.
///
/// visibility is the single most safety-critical field in the Coach App: it
/// defaults to staff_private, and a note only becomes parent-visible when a
/// coach deliberately marks it parent_shared. The Parent App reads ONLY
/// parent_shared notes. There is no bulk "share all" path by design.
model CoachNote {
  id                 String         @id @default(uuid())
  athleteId          String         @map("athlete_id")
  staffUserId        String         @map("staff_user_id")
  sessionId          String?        @map("session_id")
  visibility         NoteVisibility @default(staff_private)
  body               String
  /// Quick tags (Ball Handling, Serving, Effort...) — sport-appropriate lists
  /// live in lib/coach-tags.ts, kept out of the DB so they can change freely.
  tags               String[]       @default([])
  focus              String?
  workingOn          String?        @map("working_on")
  nextRecommendation String?        @map("next_recommendation")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  athlete Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  staff   StaffUser @relation(fields: [staffUserId], references: [id])

  @@index([athleteId, createdAt])
  @@map("coach_notes")
}

enum NoteVisibility {
  staff_private
  parent_shared
}

/// A note about the group/session rather than an individual. Never parent-facing.
model SessionNote {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  staffUserId String   @map("staff_user_id")
  body        String
  createdAt   DateTime @default(now()) @map("created_at")

  session Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff   StaffUser @relation(fields: [staffUserId], references: [id])

  @@map("session_notes")
}

/// A lightweight practice plan for one session — a short ordered list of
/// timed blocks, not whiteboard software.
model SessionPlan {
  id          String   @id @default(uuid())
  sessionId   String   @unique @map("session_id")
  staffUserId String   @map("staff_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  session Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff   StaffUser         @relation(fields: [staffUserId], references: [id])
  items   SessionPlanItem[]

  @@map("session_plans")
}

model SessionPlanItem {
  id       String  @id @default(uuid())
  planId   String  @map("plan_id")
  position Int
  minutes  Int
  activity String
  notes    String?

  plan SessionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, position])
  @@map("session_plan_items")
}

/// A reusable plan a head coach/admin approves for the whole staff (Phase 2
/// coaching library). Normal coaches can apply one to their session but not
/// create or edit approved templates.
model PlanTemplate {
  id          String   @id @default(uuid())
  name        String
  sport       String?
  category    String?
  createdById String   @map("created_by_id")
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy StaffUser          @relation(fields: [createdById], references: [id])
  items     PlanTemplateItem[]

  @@map("plan_templates")
}

model PlanTemplateItem {
  id         String  @id @default(uuid())
  templateId String  @map("template_id")
  position   Int
  minutes    Int
  activity   String
  notes      String?

  template PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, position])
  @@map("plan_template_items")
}

/// One coach's evaluation of one athlete for one league Program.
///
/// scores is Json rather than six columns because the category set is
/// sport-specific (basketball scores ball handling; volleyball scores serving)
/// and adding a sport shouldn't require a migration. The category definitions
/// live in lib/evaluation-rubrics.ts. Unique per (program, athlete, coach) so
/// several coaches can independently evaluate the same athlete and a head
/// coach can see them combined.
model Evaluation {
  id               String   @id @default(uuid())
  /// Nullable since an Initial/Baseline evaluation isn't tied to a league or
  /// any other program — it's the athlete's starting point, recorded once.
  programId        String?  @map("program_id")
  athleteId        String   @map("athlete_id")
  staffUserId      String   @map("staff_user_id")
  sport            String
  evaluationType   EvaluationType @default(league) @map("evaluation_type")
  /// Defaults to internal_only, and that default is the whole point: a league
  /// evaluation exists to balance rosters, and its scores, comparisons and
  /// placement talk are NOT parent-facing unless a human deliberately shares it.
  visibility       EvaluationVisibility @default(internal_only)
  publishedAt      DateTime? @map("published_at")
  scores           Json     @default("{}")
  notes            String?
  recommendedLevel String?  @map("recommended_level")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  program Program?  @relation(fields: [programId], references: [id], onDelete: Cascade)
  athlete Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  staff   StaffUser @relation(fields: [staffUserId], references: [id])

  @@unique([programId, athleteId, staffUserId])
  @@index([athleteId, createdAt])
  @@map("evaluations")
}

enum EvaluationType {
  /// The athlete's baseline. No invented history before it.
  initial
  league
  skills
  quarterly
  custom
}

enum EvaluationVisibility {
  internal_only
  share_with_parent
}

/// A parent's team-placement request ("would like to play with Drew").
/// Surfaced during team building as a REQUEST — explicitly advisory, never
/// auto-applied. Team assignment stays a human decision.
model PlacementRequest {
  id          String   @id @default(uuid())
  programId   String   @map("program_id")
  athleteId   String   @map("athlete_id")
  requestText String   @map("request_text")
  createdAt   DateTime @default(now()) @map("created_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("placement_requests")
}

/// Coach working availability. One table covers both shapes: a recurring
/// weekly block (weekday set, specificDate null) and a one-off conflict
/// (specificDate set, weekday null). Availability informs admin/head-coach
/// scheduling — it does not let a coach create public programming.
model CoachAvailability {
  id           String             @id @default(uuid())
  staffUserId  String             @map("staff_user_id")
  weekday      Int?
  specificDate DateTime?          @map("specific_date") @db.Date
  startMinute  Int                @map("start_minute")
  endMinute    Int                @map("end_minute")
  status       AvailabilityStatus @default(available)
  note         String?
  createdAt    DateTime           @default(now()) @map("created_at")

  staff StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@map("coach_availability")
}

enum AvailabilityStatus {
  available
  preferred
  unavailable
}

/// "I need coverage for this session." Raised by the assigned coach, resolved
/// by a head coach/admin assigning a replacement — which adds a SessionCoach
/// row with role=substitute rather than silently rewriting the original
/// assignment, so the staffing history stays legible.
model CoverageRequest {
  id            String         @id @default(uuid())
  sessionId     String         @map("session_id")
  requestedById String         @map("requested_by_id")
  reason        String?
  status        CoverageStatus @default(open)
  assignedToId  String?        @map("assigned_to_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  resolvedAt    DateTime?      @map("resolved_at")

  session     Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requestedBy StaffUser  @relation("CoverageRequestedBy", fields: [requestedById], references: [id])
  assignedTo  StaffUser? @relation("CoverageAssignedTo", fields: [assignedToId], references: [id])

  @@index([status])
  @@map("coverage_requests")
}

enum CoverageStatus {
  open
  assigned
  cancelled
}

/// Internal incident record (injury / behavior / facility). Factual fields
/// only — the form deliberately asks what happened and what was done, not for
/// any diagnosis. Visible to the reporting coach and to admin/head coach for
/// that sport; never to parents through the Parent App.
model IncidentReport {
  id                    String         @id @default(uuid())
  sessionId             String?        @map("session_id")
  athleteId             String?        @map("athlete_id")
  reportedById          String         @map("reported_by_id")
  occurredAt            DateTime       @map("occurred_at")
  incidentType          IncidentType   @map("incident_type")
  description           String
  actionTaken           String         @map("action_taken")
  parentNotified        Boolean        @default(false) @map("parent_notified")
  adminFollowUpRequired Boolean        @default(false) @map("admin_follow_up_required")
  status                IncidentStatus @default(open)
  createdAt             DateTime       @default(now()) @map("created_at")

  session    Session?  @relation(fields: [sessionId], references: [id])
  athlete    Athlete?  @relation(fields: [athleteId], references: [id])
  reportedBy StaffUser @relation(fields: [reportedById], references: [id])

  @@index([status])
  @@map("incident_reports")
}

enum IncidentType {
  injury
  behavior
  facility
  other
}

enum IncidentStatus {
  open
  under_review
  closed
}

/// A message a coach sends to an operational group. Recipients are resolved to
/// guardians at send time (CommunicationRecipient) — coaches address a session,
/// team, program or family, never a phone number, and never a minor directly.
/// The Parent App renders these; no personal contact details are exposed to
/// coaches or between families.
model Communication {
  id          String             @id @default(uuid())
  senderId    String             @map("sender_id")
  scope       CommunicationScope
  sessionId   String?            @map("session_id")
  teamId      String?            @map("team_id")
  programId   String?            @map("program_id")
  familyId    String?            @map("family_id")
  subject     String
  body        String
  sentAt      DateTime           @default(now()) @map("sent_at")

  sender     StaffUser                @relation(fields: [senderId], references: [id])
  session    Session?                 @relation(fields: [sessionId], references: [id])
  team       Team?                    @relation(fields: [teamId], references: [id])
  program    Program?                 @relation(fields: [programId], references: [id])
  family     Family?                  @relation(fields: [familyId], references: [id])
  recipients CommunicationRecipient[]
  threads    MessageThread[]

  @@index([sentAt])
  @@map("communications")
}

enum CommunicationScope {
  session
  team
  program
  family
}

/// Fan-out row: one per guardian who should see a Communication. Materialized
/// at send time so the Parent App inbox is a simple indexed read, and so the
/// recipient list is a permanent record of who was actually told what.
model CommunicationRecipient {
  id              String    @id @default(uuid())
  communicationId String    @map("communication_id")
  guardianId      String    @map("guardian_id")
  readAt          DateTime? @map("read_at")

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  guardian      Guardian      @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([communicationId, guardianId])
  @@index([guardianId, readAt])
  @@map("communication_recipients")
}

/// A sport- or program-wide notice from a head coach/admin. Broader and more
/// persistent than a Communication (which targets one specific group), and
/// surfaced in the Parent App to the families it applies to.
model Announcement {
  id          String    @id @default(uuid())
  createdById String    @map("created_by_id")
  sport       String?
  programId   String?   @map("program_id")
  teamId      String?   @map("team_id")
  title       String
  body        String
  publishedAt DateTime  @default(now()) @map("published_at")
  expiresAt   DateTime? @map("expires_at")

  createdBy StaffUser @relation(fields: [createdById], references: [id])
  program   Program?  @relation(fields: [programId], references: [id])
  team      Team?     @relation(fields: [teamId], references: [id])

  @@index([publishedAt])
  @@map("announcements")
}

/// Operational flags only. The permitted set is intentionally narrow and
/// non-stigmatizing — no health or behavioral labels live here; medical detail
/// stays in Athlete.medicalNotes behind its own permission check, and anything
/// incident-shaped belongs in IncidentReport.
model AthleteFlag {
  id          String          @id @default(uuid())
  athleteId   String          @map("athlete_id")
  flagType    AthleteFlagType @map("flag_type")
  note        String?
  createdById String          @map("created_by_id")
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  resolvedAt  DateTime?       @map("resolved_at")

  athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdBy StaffUser @relation(fields: [createdById], references: [id])

  @@index([athleteId, active])
  @@map("athlete_flags")
}

enum AthleteFlagType {
  new_athlete
  first_session
  needs_evaluation
  parent_follow_up
  attendance_concern
}

/// Manually recorded Guided Dr. Dish numbers.
///
/// These are typed in by the coach. There is NO Dr. Dish API integration in
/// this codebase — nothing here is machine-reported, and no value is inferred
/// or synthesized. If a real integration is added later it should populate
/// these same fields and set a source field, not a parallel table.
model DrDishLog {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  athleteId   String   @map("athlete_id")
  staffUserId String   @map("staff_user_id")
  workout     String?
  makes       Int?
  attempts    Int?
  focus       String?
  createdAt   DateTime @default(now()) @map("created_at")

  session Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  staff   StaffUser @relation(fields: [staffUserId], references: [id])

  @@unique([sessionId, athleteId])
  @@map("dr_dish_logs")
}

/// Append-only trail for sensitive staff actions — viewing emergency contacts
/// or medical notes, sharing a note with a parent, changing team assignments,
/// resolving coverage, filing an incident. Written by lib/audit.ts.
model AuditLog {
  id          String   @id @default(uuid())
  staffUserId String   @map("staff_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  staff StaffUser @relation(fields: [staffUserId], references: [id])

  @@index([staffUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ===========================================================================
// COURTS OS
//
// Everything below is the operational control layer. It deliberately adds to
// the existing model rather than shadowing it: a Registration points at the
// same Program the Parent App renders and the same Athlete the Coach App sees.
// There is no second copy of a family, program, session or roster anywhere.
// ===========================================================================

/// The master record of "this athlete is signed up for this program".
///
/// This is the missing middle layer the old schema lacked. A Booking is a seat
/// in ONE session; for a camp, league or multi-week clinic a family registers
/// once at the program level and then occupies many session seats. Registration
/// is that once — it owns the money, the paperwork and the status, and the
/// Bookings hang off it for attendance. For a drop-in class the Registration
/// and the single Booking are created together.
model Registration {
  id         String             @id @default(uuid())
  /// Registration attaches to the OFFERING, not the Program — a family
  /// registers for "Fall 2026 League", and may register again for Winter 2027
  /// without either row colliding with the other.
  offeringId String             @map("offering_id")
  athleteId  String             @map("athlete_id")
  /// Which shape of registration this is, per the offering's registrationMode.
  /// A camp bought as a single day and one bought whole are the same model with
  /// different selections, not two systems.
  selection  RegistrationSelection @default(all_sessions)
  /// Chosen day for a single-day camp registration.
  selectedSessionId String?      @map("selected_session_id")
  status     RegistrationStatus @default(started)
  paymentStatus PaymentStatus   @default(none) @map("payment_status")

  /// What the family was actually charged, after member pricing/promo. Held
  /// here because Stripe is the source of truth for the payment but not for
  /// "which registration was this for".
  amountCents      Int?    @map("amount_cents")
  /// Pointers only — never card data, never a cached Stripe object.
  stripeCheckoutSessionId String? @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String? @unique @map("stripe_payment_intent_id")
  promoCodeId       String? @map("promo_code_id")
  creditAppliedCents Int?   @map("credit_applied_cents")

  /// Registration question answers, keyed by question id.
  formResponses Json?     @map("form_responses")
  /// Denormalized "all required waivers signed" flag, recomputed on read in
  /// the registration detail view; stored so list views don't N+1.
  waiversComplete Boolean @default(false) @map("waivers_complete")

  /// Set when an admin registered this athlete manually rather than the
  /// family self-serving, so the audit story is legible.
  createdByStaffId String? @map("created_by_staff_id")
  adminNote        String? @map("admin_note")

  registeredAt DateTime  @default(now()) @map("registered_at")
  cancelledAt  DateTime? @map("cancelled_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  offering       Offering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  athlete        Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdByStaff StaffUser? @relation(fields: [createdByStaffId], references: [id])
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id])
  bookings       Booking[]

  /// One registration per athlete per offering. Re-registering after a
  /// cancellation updates this row, which is also what stops a double-click
  /// on Checkout from producing two registrations.
  @@unique([offeringId, athleteId])
  @@index([status])
  @@index([paymentStatus])
  @@map("registrations")
}

/// Deliberately short. Every extra status is one more thing an admin has to
/// interpret at 5pm with a gym full of kids.
enum RegistrationStatus {
  /// Family opened the flow, hasn't finished.
  started
  /// Finished the form but something is outstanding (waiver, payment info).
  incomplete
  registered
  waitlisted
  cancelled
  /// Needs a human: eligibility question, duplicate, disputed payment.
  admin_review
}

enum PaymentStatus {
  /// Free program, or nothing owed.
  none
  due
  pending
  paid
  failed
  refunded
  partially_refunded
}

/// Lightweight CRM. Explicitly NOT a general sales tool — it tracks people who
/// showed interest in The Courts and whether they converted, nothing more.
model Lead {
  id        String     @id @default(uuid())
  name      String
  email     String?
  phone     String?
  source    LeadSource @default(other)
  stage     LeadStage  @default(new)
  sport     String?
  /// Free text: "3rd grade son, asked about Tuesday group training".
  interest  String?
  notes     String?
  /// Set once the lead becomes a real family, linking pipeline to outcome.
  familyId  String?    @map("family_id")
  ownerId   String?    @map("owner_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  convertedAt DateTime? @map("converted_at")

  family     Family?        @relation(fields: [familyId], references: [id])
  owner      StaffUser?     @relation("LeadOwner", fields: [ownerId], references: [id])
  activities LeadActivity[]

  @@index([stage])
  @@index([source])
  @@map("leads")
}

enum LeadSource {
  website
  parent_referral
  coach_referral
  walk_in
  social
  nextgen_rollover
  camp
  league_evaluation
  event
  rental
  other
}

enum LeadStage {
  new
  contacted
  trial
  attended
  follow_up
  converted
  not_now
}

model LeadActivity {
  id          String   @id @default(uuid())
  leadId      String   @map("lead_id")
  staffUserId String?  @map("staff_user_id")
  note        String
  createdAt   DateTime @default(now()) @map("created_at")

  lead  Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staff StaffUser? @relation(fields: [staffUserId], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

/// A discount The Courts issued. The authoritative coupon lives in Stripe when
/// one is attached (stripePromotionCodeId); this row is the operational view —
/// who it went to, what it's for, whether it's been used.
model PromoCode {
  id          String      @id @default(uuid())
  code        String      @unique
  label       String
  /// Exactly one of these is set.
  amountOffCents Int?     @map("amount_off_cents")
  percentOff     Int?     @map("percent_off")
  status      PromoStatus @default(issued)
  /// Restricts redemption to one program (e.g. an evaluation credit that is
  /// only good against the Fall League).
  eligibleProgramId String? @map("eligible_program_id")
  source      String?
  maxRedemptions Int?     @map("max_redemptions")
  timesRedeemed  Int      @default(0) @map("times_redeemed")
  expiresAt   DateTime?   @map("expires_at")
  stripePromotionCodeId String? @unique @map("stripe_promotion_code_id")
  stripeCouponId        String? @map("stripe_coupon_id")
  createdById String?     @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  eligibleProgram Program?   @relation(fields: [eligibleProgramId], references: [id])
  createdBy       StaffUser? @relation(fields: [createdById], references: [id])
  registrations   Registration[]

  @@index([status])
  @@map("promo_codes")
}

enum PromoStatus {
  issued
  used
  expired
  cancelled
}

/// Facility unavailability that is not a booking — maintenance, a holiday, an
/// owner block. Checked by the same conflict logic that guards double-booking,
/// so a blocked court cannot take a new session.
model FacilityBlock {
  id         String  @id @default(uuid())
  /// Null means the WHOLE facility is blocked (holiday, snow closure).
  resourceId String? @map("resource_id")
  startTime  DateTime @map("start_time")
  endTime    DateTime @map("end_time")
  reason     FacilityBlockReason
  note       String?
  createdById String? @map("created_by_id")
  createdAt  DateTime @default(now()) @map("created_at")

  resource  Resource?  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdBy StaffUser? @relation(fields: [createdById], references: [id])

  @@index([startTime, endTime])
  @@map("facility_blocks")
}

enum FacilityBlockReason {
  maintenance
  private_event
  holiday
  repair
  owner_block
  other
}

/// Deliberately minimal — a follow-up list, not project management. It has no
/// projects, no subtasks, no dependencies, and that is the point.
model Task {
  id          String     @id @default(uuid())
  title       String
  detail      String?
  status      TaskStatus @default(open)
  dueDate     DateTime?  @map("due_date") @db.Date
  assignedToId String?   @map("assigned_to_id")
  createdById  String?   @map("created_by_id")

  /// Optional anchors. A task can hang off whatever it is actually about.
  familyId    String?    @map("family_id")
  programId   String?    @map("program_id")

  createdAt   DateTime   @default(now()) @map("created_at")
  completedAt DateTime?  @map("completed_at")

  assignedTo StaffUser? @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy  StaffUser? @relation("TaskCreatedBy", fields: [createdById], references: [id])
  family     Family?    @relation(fields: [familyId], references: [id])
  program    Program?   @relation(fields: [programId], references: [id])

  @@index([status, dueDate])
  @@map("tasks")
}

enum TaskStatus {
  open
  done
  cancelled
}

/// Frequently-changing marketing content, editable without a deploy. Slot-based
/// rather than a general CMS: there is a fixed set of places on the website and
/// in the apps whose copy changes weekly, and this covers exactly those.
model ContentBlock {
  id          String       @id @default(uuid())
  slot        ContentSlot  @unique
  enabled     Boolean      @default(false)
  headline    String?
  body        String?
  linkLabel   String?      @map("link_label")
  linkUrl     String?      @map("link_url")
  /// For the "featured program" slots.
  programId   String?      @map("program_id")
  updatedById String?      @map("updated_by_id")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")

  updatedBy StaffUser? @relation(fields: [updatedById], references: [id])

  @@map("content_blocks")
}

enum ContentSlot {
  announcement_bar
  homepage_featured_program
  featured_camp
  featured_league
  featured_event
  emergency_closure
  this_week_at_the_courts
  parent_app_announcement
  coach_app_announcement
}

/// Which waivers a program requires. A join table rather than an array column
/// so the registration flow can check completion with a real query.
/// Which waivers an Offering requires. Attached per Offering rather than per
/// Program because a camp and a court rental of the same facility need
/// different paperwork, and a new season is the moment to re-check it.
model OfferingWaiver {
  offeringId String @map("offering_id")
  waiverId   String @map("waiver_id")

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  waiver   Waiver   @relation(fields: [waiverId], references: [id], onDelete: Cascade)

  @@id([offeringId, waiverId])
  @@map("offering_waivers")
}

// ---------------------------------------------------------------------------
// SCHEDULING ENGINE
//
// Everything below exists so that a schedule can be built once, changed safely,
// and explained afterwards. The three jobs are: remember the RULE a series came
// from (RecurrenceRule), record every deliberate deviation and who made it
// (ScheduleChange, ConflictOverride), and let one occurrence occupy more than
// one court (SessionResource).
// ---------------------------------------------------------------------------

/// The rule a recurring series was generated from. Sessions are still
/// materialized rows — this is kept so "edit this and future" can regenerate
/// the tail of a series, and so the builder can show the admin what they built
/// instead of making them reverse-engineer it from 11 rows.
model RecurrenceRule {
  id         String @id @default(uuid())
  offeringId String @map("offering_id")
  /// Mirrors ScheduleSpec in lib/programs/recurrence.ts.
  frequency  RecurrenceFrequency @default(weekly)
  /// 0 = Sunday, matching Date.getUTCDay().
  weekdays   Int[]  @default([])
  /// Wall-clock minutes from midnight (17*60 = 5:00 PM).
  startMinute     Int @map("start_minute")
  durationMinutes Int @map("duration_minutes")
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  /// Default resource + capacity applied to generated occurrences. An individual
  /// session may diverge; that marks it as an exception.
  resourceId String? @map("resource_id")
  capacity   Int?
  createdAt  DateTime @default(now()) @map("created_at")

  offering Offering  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([offeringId])
  @@map("recurrence_rules")
}

enum RecurrenceFrequency {
  weekly
  biweekly
}

/// Additional resources for one occurrence — a camp taking Court 1 AND Court 2,
/// an evaluation using the whole facility. Session.resourceId stays the primary;
/// these are the extras, and the conflict engine treats them identically.
model SessionResource {
  sessionId  String @map("session_id")
  resourceId String @map("resource_id")

  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([sessionId, resourceId])
  @@index([resourceId])
  @@map("session_resources")
}

/// What changed about a scheduled session, when, by whom, and whether families
/// were told. Distinct from AuditLog on purpose: this is the record that gets
/// read back to a parent who says "nobody told us it moved", so it is scoped
/// tightly to schedule changes and carries the notification outcome.
model ScheduleChange {
  id         String @id @default(uuid())
  sessionId  String? @map("session_id")
  offeringId String? @map("offering_id")
  changeType ScheduleChangeType @map("change_type")
  /// Human-readable before/after, rendered directly in the history timeline.
  previousValue String? @map("previous_value")
  newValue      String? @map("new_value")
  reason        String?
  /// Whether the people attached to this session were told.
  ///
  /// Read these together with `notificationMethod`. On their own they record an
  /// admin's INTENT, not a delivered message — there is no email or SMS
  /// transport wired up yet, so a `true` here with method `marked_manually`
  /// means "an admin said they would tell them", not "the system sent
  /// something". Keeping those two claims separate matters: this table is what
  /// gets read back to a parent who says nobody told them.
  familiesNotified Boolean? @map("families_notified")
  coachNotified    Boolean? @map("coach_notified")
  /// How the notification happened. `marked_manually` = an admin ticked the box
  /// and is sending it themselves. `sent_automatically` = the platform actually
  /// delivered it — nothing sets this yet, and nothing should until a transport
  /// exists. Null on rows written before this distinction existed.
  notificationMethod NotificationMethod? @map("notification_method")
  /// How many registrations were attached when the change was made — the number
  /// that actually matters when judging the impact later.
  affectedRegistrations Int @default(0) @map("affected_registrations")
  changedById String?  @map("changed_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  session   Session?   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  offering  Offering?  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  changedBy StaffUser? @relation(fields: [changedById], references: [id])

  @@index([sessionId, createdAt])
  @@index([offeringId, createdAt])
  @@map("schedule_changes")
}

/// Deliberately distinguishes "a person said they'd handle it" from "the
/// platform sent it". Collapsing the two would let the schedule history claim a
/// family was contacted when no message ever left the building.
enum NotificationMethod {
  marked_manually
  sent_automatically
}

enum ScheduleChangeType {
  created
  moved
  cancelled
  restored
  resource_changed
  coach_changed
  capacity_changed
  rescheduled
  makeup_added
  series_edited
}

/// A soft conflict an authorized admin deliberately accepted. Recording the
/// reason is what separates "we know, it's fine, Johnny only needs 10 minutes"
/// from a double-booking nobody noticed.
model ConflictOverride {
  id           String @id @default(uuid())
  sessionId    String @map("session_id")
  conflictType String @map("conflict_type")
  detail       String
  reason       String
  overriddenById String   @map("overridden_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overriddenBy StaffUser @relation(fields: [overriddenById], references: [id])

  @@index([sessionId])
  @@map("conflict_overrides")
}

/// A reusable starting point for a new Offering.
///
/// Deliberately stores STRUCTURE only — capacity, duration, eligibility,
/// registration and visibility rules. It does not carry dates, coach
/// assignments, Stripe prices or season names, because a template that
/// resurrects last season's price or last season's coach is worse than no
/// template at all. The builder re-asks for those every time.
model OfferingTemplate {
  id          String      @id @default(uuid())
  name        String
  programType ProgramType @map("program_type")
  sport       String?
  /// The structural defaults, shaped like OfferingTemplateConfig in
  /// lib/programs/templates.ts. Json because the field set differs per program
  /// type and adding a type should not require a migration.
  config      Json        @default("{}")
  createdById String?     @map("created_by_id")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")

  createdBy StaffUser? @relation(fields: [createdById], references: [id])
  offerings Offering[]

  @@map("offering_templates")
}

/// Offering-level waitlist, for the cases where a family wants the whole thing
/// (a full camp, a full league season) rather than one occurrence. Same explicit
/// offer semantics as WaitlistEntry — nobody is enrolled or charged without
/// accepting an offer first.
model OfferingWaitlistEntry {
  id         String              @id @default(uuid())
  offeringId String              @map("offering_id")
  athleteId  String              @map("athlete_id")
  position   Int
  status     WaitlistEntryStatus @default(waiting)
  offeredAt      DateTime? @map("offered_at")
  offerExpiresAt DateTime? @map("offer_expires_at")
  offeredById    String?   @map("offered_by_id")
  respondedAt    DateTime? @map("responded_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  offering  Offering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  athlete   Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  offeredBy StaffUser? @relation(fields: [offeredById], references: [id])

  @@unique([offeringId, athleteId])
  @@index([offeringId, status, position])
  @@map("offering_waitlist_entries")
}

/// Which shape of registration a family bought. One model, several selections —
/// not a separate system per program type.
enum RegistrationSelection {
  all_sessions
  single_day
  team_season
}

// ===========================================================================
// ATHLETE PROFILE
//
// The single source of truth for who an athlete is, shared by the Parent App,
// the Coach App, the Front Desk and Courts OS. There is deliberately no second
// athlete record anywhere: each surface reads THIS athlete through its own
// authorization layer and sees a different slice of it.
//
// The organising rule for everything below: information is separated by WHO
// NEEDS IT, not by which form collected it. Medical, custody, pickup and media
// consent are four different audiences, so they are four different tables with
// four different access rules — never one "notes" blob.
// ===========================================================================

/// Who to call when something happens. Structured rather than the old free-text
/// column so the front desk can actually dial it, and so "same as Mom" doesn't
/// mean retyping a phone number that then drifts out of date.
model EmergencyContact {
  id           String   @id @default(uuid())
  athleteId    String   @map("athlete_id")
  name         String
  relationship String
  phone        String
  /// Set when the parent picked "Same as Parent / Guardian". The name/phone are
  /// still copied here so a lookup never depends on a join at 7pm on a Saturday,
  /// but this records where it came from.
  guardianId   String?  @map("guardian_id")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  athlete  Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  guardian Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  @@index([athleteId, sortOrder])
  @@map("emergency_contacts")
}

/// A non-guardian adult allowed to collect this athlete — grandparent, nanny,
/// a teammate's parent on carpool days. Guardians' own pickup rights live on
/// FamilyGuardian.authorizedForPickup instead of being duplicated here.
///
/// Matters most for camps, Parents' Night Out and drop-off programming; normal
/// training sessions do not run a formal pickup procedure.
model AuthorizedPickup {
  id           String   @id @default(uuid())
  athleteId    String   @map("athlete_id")
  name         String
  relationship String
  phone        String
  note         String?
  guardianId   String?  @map("guardian_id")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  athlete  Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  guardian Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  @@index([athleteId, active])
  @@map("authorized_pickups")
}

/// Permission to use photos/video of this athlete in Courts marketing.
///
/// Entirely separate from the profile photo: uploading a picture so coaches can
/// put a name to a face grants NOTHING here. It is also separate from the
/// liability waiver — a parent must answer this question on its own, and
/// answering NO must never block participation.
model MediaConsent {
  id        String             @id @default(uuid())
  athleteId String             @unique @map("athlete_id")
  status    MediaConsentStatus
  /// The guardian who actually made the choice. A child cannot consent.
  consentedByGuardianId String @map("consented_by_guardian_id")
  /// Captured as typed, not resolved from the guardian row at read time — this
  /// is a record of what was acknowledged, and it must not change retroactively
  /// if the guardian later edits their name.
  guardianName         String  @map("guardian_name")
  guardianRelationship String  @map("guardian_relationship")
  acknowledged         Boolean @default(false)
  consentDate          DateTime @map("consent_date")
  /// Which version of the release text was on screen when they agreed.
  releaseVersion       String  @map("release_version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  guardian  Guardian @relation(fields: [consentedByGuardianId], references: [id])

  @@map("media_consents")
}

enum MediaConsentStatus {
  /// Photos + video are okay on Courts-owned channels.
  media_ok
  /// Ask before using anything identifiable.
  media_limited
  /// No identifiable photo or video in marketing.
  media_no
}

/// Every change of mind, kept forever. Needed for two reasons: a parent is
/// entitled to know what they agreed to and when, and if permission is
/// withdrawn after something has already been published, staff need the dates
/// to work out what is already out in the world.
model MediaConsentChange {
  id              String              @id @default(uuid())
  athleteId       String              @map("athlete_id")
  oldStatus       MediaConsentStatus? @map("old_status")
  newStatus       MediaConsentStatus  @map("new_status")
  changedByGuardianId String?         @map("changed_by_guardian_id")
  changedByStaffId    String?         @map("changed_by_staff_id")
  releaseVersion  String              @map("release_version")
  /// Set when a withdrawal needs a human to review already-published material.
  /// Nothing here promises that distributed material disappears on its own.
  needsFollowUp   Boolean             @default(false) @map("needs_follow_up")
  followUpDoneAt  DateTime?           @map("follow_up_done_at")
  createdAt       DateTime            @default(now()) @map("created_at")

  athlete   Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  guardian  Guardian?  @relation(fields: [changedByGuardianId], references: [id], onDelete: SetNull)
  staff     StaffUser? @relation(fields: [changedByStaffId], references: [id], onDelete: SetNull)

  @@index([athleteId, createdAt])
  @@index([needsFollowUp, followUpDoneAt])
  @@map("media_consent_changes")
}

// ---------------------------------------------------------------------------
// PROGRESS
//
// A roughly quarterly, coach-written picture of how an athlete is developing.
// Compared against their OWN past quarters and nothing else: there is no
// percentile, no leaderboard, no teammate comparison anywhere in this model,
// and that absence is the design.
// ---------------------------------------------------------------------------

model ProgressReport {
  id        String   @id @default(uuid())
  athleteId String   @map("athlete_id")
  sport     String
  /// Calendar year + quarter 1-4. Stored as two ints rather than a label so
  /// ordering, "most recent first" and trend lookups are plain SQL, and so
  /// nobody has to create quarters by hand each year (lib/quarters.ts).
  year      Int
  quarter   Int
  status    ProgressReportStatus @default(draft)

  /// Short coach summary in plain language. Not an essay.
  coachTake String? @map("coach_take")

  /// What to work on next, and optionally where that happens. The program
  /// pointers are nullable on purpose — a coach is never forced to make a
  /// commercial recommendation to finish a report.
  upNextFocus       String? @map("up_next_focus")
  upNextProgramType String? @map("up_next_program_type")
  upNextOfferingId  String? @map("up_next_offering_id")

  /// Attendance CONTEXT for the quarter ({"Group Training": 11, "Private": 2}),
  /// snapshotted at publish so a later cancellation can't silently rewrite a
  /// published report. Context only — never scored, never a grade.
  participation Json? @map("participation")

  authorStaffId     String    @map("author_staff_id")
  reviewedByStaffId String?   @map("reviewed_by_staff_id")
  publishedAt       DateTime? @map("published_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  athlete    Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  author     StaffUser @relation("ProgressAuthor", fields: [authorStaffId], references: [id])
  reviewedBy StaffUser? @relation("ProgressReviewer", fields: [reviewedByStaffId], references: [id])
  skills     ProgressSkill[]
  priorities ProgressPriority[]

  /// One report per athlete per sport per quarter — a second draft for the same
  /// quarter is an edit, not a new row.
  @@unique([athleteId, sport, year, quarter])
  @@index([athleteId, year, quarter])
  @@index([status, year, quarter])
  @@map("progress_reports")
}

enum ProgressReportStatus {
  draft
  ready_for_review
  published
}

/// One skill line on a report. `level` is the 1-5 development scale from
/// lib/progress-metrics.ts (Building → Advanced); parents see the WORD.
model ProgressSkill {
  id       String  @id @default(uuid())
  reportId String  @map("report_id")
  /// Key from the sport's metric list — basketball and volleyball have their
  /// own, and volleyball is never scored on basketball categories.
  metric   String
  level    Int
  /// True for the 2-4 lines shown under "What's Clicking".
  clicking Boolean @default(false)
  comment  String?
  sortOrder Int    @default(0) @map("sort_order")

  report ProgressReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, metric])
  @@map("progress_skills")
}

/// "What We're Working On" — 1-3 development priorities, in the coach's words.
model ProgressPriority {
  id        String @id @default(uuid())
  reportId  String @map("report_id")
  label     String
  sortOrder Int    @default(0) @map("sort_order")

  report ProgressReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("progress_priorities")
}

// ---------------------------------------------------------------------------
// AUDIT
//
// AuditLog already covers staff actions. This covers the other half: parents
// change their own athlete's sensitive fields too, and "who changed the pickup
// list" has to be answerable regardless of which side of the system did it.
// ---------------------------------------------------------------------------

model AthleteProfileChange {
  id        String           @id @default(uuid())
  athleteId String           @map("athlete_id")
  actorType ProfileActorType @map("actor_type")
  actorGuardianId String?    @map("actor_guardian_id")
  actorStaffId    String?    @map("actor_staff_id")
  /// Denormalised display name, so history stays readable after a staff member
  /// leaves or a guardian is removed from the family.
  actorLabel      String     @map("actor_label")
  /// media_consent | guardians | emergency | pickup | custody | medical | profile
  category  String
  field     String
  /// Values are recorded for the categories where "what did it used to say"
  /// matters. For medical and custody free text the values are deliberately
  /// NOT copied here — the audit trail should not become a second, unguarded
  /// store of the most sensitive text in the system.
  oldValue  String? @map("old_value")
  newValue  String? @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  athlete  Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  guardian Guardian?  @relation(fields: [actorGuardianId], references: [id], onDelete: SetNull)
  staff    StaffUser? @relation(fields: [actorStaffId], references: [id], onDelete: SetNull)

  @@index([athleteId, createdAt])
  @@index([category, createdAt])
  @@map("athlete_profile_changes")
}

enum ProfileActorType {
  guardian
  staff
  system
}

// ---------------------------------------------------------------------------
// TWO-WAY MESSAGING (The Courts <-> one family)
//
// Deliberately separate from Communication above. A Communication is a
// BROADCAST — one staff message fanned out to many families, where nobody
// replies to everybody. A MessageThread is a CONVERSATION with exactly one
// family, which is what a parent asking "will Tuesday be made up?" needs.
//
// There is no parent-to-parent channel here, and there will not be one by
// accident: a thread always has exactly one family on one side and The Courts
// on the other. Families are never exposed to each other, and no phone number
// or email address crosses either way — staff address a family, not a contact.
// ---------------------------------------------------------------------------

model MessageThread {
  id       String @id @default(uuid())
  familyId String @map("family_id")
  subject  String

  /// What the conversation is about, when it started from something specific.
  /// Gives staff the context to answer without asking the parent to re-explain.
  offeringId String? @map("offering_id")
  sessionId  String? @map("session_id")
  athleteId  String? @map("athlete_id")
  /// Set when a parent replied to a broadcast, so the answer keeps its origin.
  communicationId String? @map("communication_id")

  status        ThreadStatus @default(open)
  /// Denormalized for inbox ordering without loading every message.
  lastMessageAt DateTime     @default(now()) @map("last_message_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  offering      Offering?      @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  session       Session?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  athlete       Athlete?       @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  communication Communication? @relation(fields: [communicationId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@index([familyId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@map("message_threads")
}

enum ThreadStatus {
  open
  /// Answered and closed by staff. A new reply from the family reopens it,
  /// rather than disappearing into a resolved thread nobody watches.
  resolved
}

/// One message in a thread. Exactly one of authorGuardianId / authorStaffId is
/// set — that is what makes "who said this" unambiguous, and it is enforced by
/// the send functions in lib/messaging.ts rather than a DB constraint, since
/// Postgres cannot express "exactly one of these two" cleanly.
model Message {
  id       String @id @default(uuid())
  threadId String @map("thread_id")
  body     String

  authorGuardianId String? @map("author_guardian_id")
  authorStaffId    String? @map("author_staff_id")

  /// When the other side saw it. Null means unread by them.
  readByFamilyAt DateTime? @map("read_by_family_at")
  readByStaffAt  DateTime? @map("read_by_staff_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  thread        MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorGuardian Guardian?    @relation(fields: [authorGuardianId], references: [id], onDelete: SetNull)
  authorStaff    StaffUser?   @relation(fields: [authorStaffId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@map("messages")
}

/// A SEPARATE approval for making one athlete the subject of a piece of
/// content, rather than one of many people in it.
///
/// General media consent (MediaConsent) covers practice photography, camp and
/// league shots, group and background footage — the ordinary content of a gym.
/// It deliberately does NOT cover an athlete spotlight, a testimonial, an
/// interview, a direct-to-camera video, a full-name feature, or the centrepiece
/// of a paid campaign. Those make a child the story rather than a participant,
/// and a parent who agreed to the first has not agreed to the second.
///
/// A row here is requested by staff and answered by a guardian. media_ok on the
/// athlete is a precondition, never a substitute.
model FeaturedContentApproval {
  id        String @id @default(uuid())
  athleteId String @map("athlete_id")

  kind        FeaturedContentKind
  /// What is actually being asked for, in plain words the guardian will read.
  description String
  /// Where it would appear, if narrower than the general release.
  intendedUse String? @map("intended_use")
  /// Whether the athlete's full name would be published. Defaults false, and
  /// the general release never grants it.
  usesFullName Boolean @default(false) @map("uses_full_name")

  status        FeaturedApprovalStatus @default(requested)
  requestedById String   @map("requested_by_id")
  requestedAt   DateTime @default(now()) @map("requested_at")

  decidedByGuardianId String?   @map("decided_by_guardian_id")
  /// Snapshot, for the same reason MediaConsent snapshots it: a record of what
  /// was agreed must not change if the guardian later edits their name.
  decidedByName       String?   @map("decided_by_name")
  decidedAt           DateTime? @map("decided_at")
  guardianNote        String?   @map("guardian_note")
  /// Time-bounded on purpose: permission for a campaign is not permission
  /// forever. Null means no stated end.
  expiresAt           DateTime? @map("expires_at")
  releaseVersion      String    @map("release_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  requestedBy StaffUser @relation(fields: [requestedById], references: [id])
  decidedBy   Guardian? @relation(fields: [decidedByGuardianId], references: [id])

  @@index([athleteId, status])
  @@index([status, requestedAt])
  @@map("featured_content_approvals")
}

enum FeaturedContentKind {
  spotlight
  testimonial
  interview
  full_name_feature
  campaign_centerpiece
  other
}

enum FeaturedApprovalStatus {
  requested
  approved
  declined
  /// Past expiresAt. The content may still exist; the permission does not.
  expired
  withdrawn
}
