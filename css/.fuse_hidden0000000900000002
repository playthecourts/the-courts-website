.schedule-filters-inner { display: flex; gap: 28px; flex-wrap: wrap; align-items: center; padding: 16px var(--pad); }
.schedule-filter-label { display: block; font-family: var(--font-sport); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gray-dark); margin-bottom: 6px; }
.schedule-filter-group { display: flex; gap: 8px; flex-wrap: nowrap; overflow-x: auto; }
