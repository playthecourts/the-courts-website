.schedule-row { display: grid; grid-template-columns: 110px 1fr 120px 130px; align-items: center; gap: 18px; padding: 20px 0 20px 16px; border-top: 1px solid var(--gray-mid); border-left: 3px solid var(--gray-mid); }
