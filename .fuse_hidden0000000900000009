<section style="padding:90px 0 70px;" id="contact-form">
  <div class="container" style="max-width:640px;">
    <div class="contact-form-wrap">
      <span class="eyebrow">Get In Touch</span>
      <h2 class="section-title" style="margin-bottom:32px;">Say Hello.</h2>

      <div id="contactFormSuccess" class="form-success" style="display:none;">
        <h3>Thanks. We Got It.</h3>
        <p>We'll be in touch soon.</p>
      </div>

      <form id="contactForm">
        <div class="form-row">
          <label for="cName">Name*</label>
          <input type="text" id="cName" required>
        </div>
        <div class="form-row">
          <label for="cEmail">Email*</label>
          <input type="email" id="cEmail" required>
        </div>
        <div class="form-row">
          <label for="cInterest">I'm interested in...*</label>
          <select id="cInterest" required>
            <option value="">Select one</option>
            <option value="Membership">Membership</option>
            <option value="Basketball">Basketball</option>
            <option value="Volleyball">Volleyball</option>
            <option value="Private Training">Private Training</option>
            <option value="Camps + Clinics">Camps + Clinics</option>
            <option value="Basketball Leagues">Basketball Leagues</option>
            <option value="Open Gym">Open Gym</option>
            <option value="Court Rental">Court Rental</option>
            <option value="Birthday Party / Event">Birthday Party / Event</option>
            <option value="Current Member Support">Current Member Support</option>
            <option value="Coaching at The Courts">Coaching at The Courts</option>
            <option value="Community / Partnership">Community / Partnership</option>
            <option value="Something Else">Something Else</option>
          </select>
        </div>
        <div id="privateTrainingFields" style="display:none;">
          <div class="form-row">
            <label for="ptSport">Sport</label>
            <select id="ptSport">
              <option value="">Select one</option>
              <option value="Basketball">Basketball</option>
              <option value="Volleyball">Volleyball</option>
            </select>
          </div>
          <div class="form-row">
            <label for="ptAge">Athlete Age</label>
            <input type="text" id="ptAge">
          </div>
          <div class="form-row">
            <label for="ptFocus">What are they working on?</label>
            <input type="text" id="ptFocus">
          </div>
          <div class="form-row">
            <label for="ptTimes">Preferred Days/Times <span style="font-weight:400; color:var(--gray-dark);">(optional)</span></label>
            <input type="text" id="ptTimes">
          </div>
          <div class="form-row">
            <label for="ptCoach">Coach Preference <span style="font-weight:400; color:var(--gray-dark);">(optional)</span></label>
            <select id="ptCoach">
              <option value="">No preference</option>
              <option value="Johnny Coles">Johnny Coles</option>
              <option value="Spencer Richardson">Spencer Richardson</option>
              <option value="Justin Frank">Justin Frank</option>
              <option value="Sarah Quint">Sarah Quint</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <label for="cMessage">Anything else we should know?*</label>
          <textarea id="cMessage" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Send It →</button>
      </form>
      <p style="font-size:13px; color:var(--gray-dark); margin-top:16px;">For athletes under 13, this form should be completed by a parent or guardian.</p>
    </div>
  </div>
</section>

